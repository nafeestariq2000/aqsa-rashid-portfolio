---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SocialHero from '../../components/services/SocialHero.astro';
import SocialDeliverables from '../../components/services/SocialDeliverables.astro';
import SocialWorkflow from '../../components/services/SocialWorkflow.astro';
import SocialPricing from '../../components/services/SocialPricing.astro';
import SocialFAQ from '../../components/services/SocialFAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://aqsarashid.com/#services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Social Media & Brand Design",
      "item": "https://aqsarashid.com/services/social-media-design/"
    }
  ]
});

const relatedLinks = [
  {
    title: "Apex Fitness Club Gym Branding Case Study",
    subtitle: "Explore how high-contrast Instagram carousels and ad visuals generated +450% social reach.",
    url: `${import.meta.env.BASE_URL}work/fitness-social-media-branding/`,
    badge: "Featured Branding Case Study",
    icon: "🎨"
  },
  {
    title: "Figma Web UI/UX Design",
    subtitle: "Need custom Web UI layouts or landing page wireframes alongside social brand assets?",
    url: `${import.meta.env.BASE_URL}services/figma-ui-ux-design/`,
    badge: "Complementary Service",
    icon: "❖"
  },
  {
    title: "Services Overview Hub",
    subtitle: "Compare all 3 core service offerings, deliverables, turnarounds, and pricing matrix.",
    url: `${import.meta.env.BASE_URL}services/`,
    badge: "Services Hub",
    icon: "🚀"
  }
];
---

<Layout
  title="Social Media & Brand Designer Services | Custom Carousels & Brand Identity — Aqsa Rashid"
  description="Hire Google UX Certified Visual Designer Aqsa Rashid for high-engagement Instagram carousels, promotional ad banners, LinkedIn graphics, and brand style guides."
>
  <!-- Embed Breadcrumb Schema -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Section -->
    <SocialHero />

    <!-- Section 2: Creative Deliverables Grid -->
    <SocialDeliverables />

    <!-- Section 3: 4-Step Creative Workflow -->
    <SocialWorkflow />

    <!-- Section 4: Social Media Pricing Packages -->
    <SocialPricing />

    <!-- Section 5: Branding Service FAQ -->
    <SocialFAQ />

    <!-- Section 6: Related Internal Links -->
    <RelatedLinks
      heading="Related Branding Work & Next Steps"
      links={relatedLinks}
    />

    <!-- Section 7: Direct Contact Form & Booking -->
    <Contact />
  </main>

  <Footer />
</Layout>

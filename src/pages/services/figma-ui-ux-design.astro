---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FigmaHero from '../../components/services/FigmaHero.astro';
import FigmaDeliverables from '../../components/services/FigmaDeliverables.astro';
import FigmaWorkflow from '../../components/services/FigmaWorkflow.astro';
import FigmaPricing from '../../components/services/FigmaPricing.astro';
import FigmaFAQ from '../../components/services/FigmaFAQ.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://aqsarashid.com/#services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Figma UI/UX Design",
      "item": "https://aqsarashid.com/services/figma-ui-ux-design/"
    }
  ]
});
---

<Layout
  title="Figma UI/UX Design Services | Custom Web & Landing Page Designer — Aqsa Rashid"
  description="Hire Google UX Certified Figma UI/UX Designer Aqsa Rashid. Designing high-converting landing page layouts, SaaS web apps, wireframes, and scalable design systems."
>
  <!-- Embed Breadcrumb Schema -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Section -->
    <FigmaHero />

    <!-- Section 2: Comprehensive Deliverables Grid -->
    <FigmaDeliverables />

    <!-- Section 3: 4-Step Google UX Workflow -->
    <FigmaWorkflow />

    <!-- Section 4: Transparent Pricing Packages -->
    <FigmaPricing />

    <!-- Section 5: Figma Service FAQ -->
    <FigmaFAQ />

    <!-- Section 6: Direct Contact Form & Booking -->
    <Contact />
  </main>

  <Footer />
</Layout>

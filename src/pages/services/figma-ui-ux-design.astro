---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FigmaHero from '../../components/services/FigmaHero.astro';
import FigmaDeliverables from '../../components/services/FigmaDeliverables.astro';
import FigmaWorkflow from '../../components/services/FigmaWorkflow.astro';
import FigmaPricing from '../../components/services/FigmaPricing.astro';
import FigmaFAQ from '../../components/services/FigmaFAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://aqsarashid.com/#services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Figma UI/UX Design",
      "item": "https://aqsarashid.com/services/figma-ui-ux-design/"
    }
  ]
});

const relatedLinks = [
  {
    title: "SaaS Video Platform UI Case Study",
    subtitle: "See how Google UX wireframes & Figma prototypes drove +35% higher conversions.",
    url: `${import.meta.env.BASE_URL}work/saas-video-landing-page/`,
    badge: "Featured Case Study",
    icon: "📁"
  },
  {
    title: "Figma to Webflow Development",
    subtitle: "Turn your approved Figma UI screens into production-ready, fast Webflow sites.",
    url: `${import.meta.env.BASE_URL}services/figma-to-webflow/`,
    badge: "Complementary Service",
    icon: "⚡"
  },
  {
    title: "Services Overview Hub",
    subtitle: "Compare all 3 core service offerings, deliverables, turnarounds, and pricing matrix.",
    url: `${import.meta.env.BASE_URL}services/`,
    badge: "Services Hub",
    icon: "🚀"
  }
];
---

<Layout
  title="Figma UI/UX Design Services | Custom Web & Landing Page Designer — Aqsa Rashid"
  description="Hire Google UX Certified Figma UI/UX Designer Aqsa Rashid. Designing high-converting landing page layouts, SaaS web apps, wireframes, and scalable design systems."
>
  <!-- Embed Breadcrumb Schema -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Section -->
    <FigmaHero />

    <!-- Section 2: Comprehensive Deliverables Grid -->
    <FigmaDeliverables />

    <!-- Section 3: 4-Step Google UX Workflow -->
    <FigmaWorkflow />

    <!-- Section 4: Transparent Pricing Packages -->
    <FigmaPricing />

    <!-- Section 5: Figma Service FAQ -->
    <FigmaFAQ />

    <!-- Section 6: Related Internal Links -->
    <RelatedLinks
      heading="Related UI/UX Work & Next Steps"
      links={relatedLinks}
    />

    <!-- Section 7: Direct Contact Form & Booking -->
    <Contact />
  </main>

  <Footer />
</Layout>

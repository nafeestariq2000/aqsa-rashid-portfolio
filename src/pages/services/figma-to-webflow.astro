---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import WebflowHero from '../../components/services/WebflowHero.astro';
import WebflowFeatures from '../../components/services/WebflowFeatures.astro';
import WebflowWorkflow from '../../components/services/WebflowWorkflow.astro';
import WebflowPricing from '../../components/services/WebflowPricing.astro';
import WebflowFAQ from '../../components/services/WebflowFAQ.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://aqsarashid.com/#services"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Figma to Webflow",
      "item": "https://aqsarashid.com/services/figma-to-webflow/"
    }
  ]
});

const relatedLinks = [
  {
    title: "Solar Energy Webflow System Case Study",
    subtitle: "Discover how a Figma to Webflow build with custom ROI calculator drove +210% consultations.",
    url: `${import.meta.env.BASE_URL}work/solar-energy-website/`,
    badge: "Featured Webflow Case Study",
    icon: "⚡"
  },
  {
    title: "Figma Web UI/UX Design",
    subtitle: "Need custom Figma wireframes & UI prototypes before Webflow development?",
    url: `${import.meta.env.BASE_URL}services/figma-ui-ux-design/`,
    badge: "Prerequisite Service",
    icon: "❖"
  },
  {
    title: "Services Overview Hub",
    subtitle: "Compare all 3 core service offerings, deliverables, turnarounds, and pricing matrix.",
    url: `${import.meta.env.BASE_URL}services/`,
    badge: "Services Hub",
    icon: "🚀"
  }
];
---

<Layout
  title="Figma to Webflow Developer Services | Custom Webflow Build — Aqsa Rashid"
  description="Hire Webflow Specialist Aqsa Rashid for pixel-perfect Figma to Webflow development. Clean Client-First class architecture, responsive breakpoints, CMS, and 100/100 Core Web Vitals."
>
  <!-- Embed Breadcrumb Schema -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Section -->
    <WebflowHero />

    <!-- Section 2: Technical Specifications Grid -->
    <WebflowFeatures />

    <!-- Section 3: 4-Step Webflow Workflow -->
    <WebflowWorkflow />

    <!-- Section 4: Webflow Pricing Packages -->
    <WebflowPricing />

    <!-- Section 5: Webflow Service FAQ -->
    <WebflowFAQ />

    <!-- Section 6: Related Internal Links -->
    <RelatedLinks
      heading="Related Webflow Work & Next Steps"
      links={relatedLinks}
    />

    <!-- Section 7: Direct Contact Form & Booking -->
    <Contact />
  </main>

  <Footer />
</Layout>

            data-filter="repeat"
            class="filter-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 bg-zinc-900 dark:bg-zinc-900 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-400 hover:border-brand-500/40"
          >
            Repeat Clients ({reviewsData.filter(r => r.isRepeat).length})
          </button>
        </div>

        <!-- Reviews Masonry / Grid Container -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="reviews-grid">
          {reviewsData.map((item) => (
            <div
              class="review-card relative p-8 rounded-3xl bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 shadow-xl flex flex-col justify-between hover:border-brand-500/50 hover:-translate-y-1 transition-all duration-300"
              data-category={item.category}
              data-is-repeat={item.isRepeat ? "true" : "false"}
            >
              
              <div>
                <!-- Rating Stars & Tag Badge -->
                <div class="flex items-center justify-between mb-6">
                  <div class="flex items-center gap-1 text-amber-400 text-lg">
                    ★★★★★
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-400 border border-brand-500/20">
                    {item.tag}
                  </span>
                </div>

                <!-- Testimonial Quote -->
                <p class="text-sm text-zinc-300 dark:text-zinc-300 light:text-zinc-700 leading-relaxed italic mb-8 font-normal">
                  "{item.quote}"
                </p>
              </div>

              <!-- Client Info Footer -->
              <div class="pt-6 border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-100 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-400 via-brand-500 to-amber-500 flex items-center justify-center text-white font-bold text-sm shadow-md">
                    {item.initials}
                  </div>
                  <div>
                    <h3 class="text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900">
                      {item.name}
                    </h3>
                  </div>
                </div>

                <span class="text-xs font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
                  {item.categoryLabel}
                </span>
              </div>

            </div>
          ))}
        </div>

        <!-- Trust Guarantee Banner -->
        <div class="mt-16 p-8 rounded-3xl bg-zinc-900/60 dark:bg-zinc-900/60 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-2xl shrink-0">
              🛡️
            </div>
            <div>
              <h3 class="font-display text-lg font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900">
                100% Authentic Client Feedback Guarantee
              </h3>
              <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-400 light:text-zinc-600 font-normal">
                Every review represents a real project delivered with precision, clear communication, and Google UX design standards.
              </p>
            </div>
          </div>

          <a
            href={`${import.meta.env.BASE_URL}contact/`}
            class="px-6 py-3.5 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 transition-all whitespace-nowrap inline-flex items-center gap-1.5 group"
          >
            <span>Start Your Project</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        </div>

      </div>
    </section>

    <!-- Related Links / Next Steps -->
    <RelatedLinks
      heading="Explore Portfolio Work & Service Offerings"
      subheading="Discover real case studies, service tier breakdowns, and Aqsa's background credentials."
      links={relatedLinks}
    />

    <!-- Bottom Action CTA Banner -->
    <section class="py-16 sm:py-20 bg-zinc-950 dark:bg-zinc-950 light:bg-zinc-100 border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <span class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-3 block">
          READY TO WORK TOGETHER?
        </span>

        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-4">
          Let’s Build Something <span class="text-gradient">Extraordinary</span>.
        </h2>

        <p class="text-base sm:text-lg text-zinc-400 dark:text-zinc-400 light:text-zinc-600 mb-8 font-normal max-w-2xl mx-auto">
          Whether you need a high-converting Figma web UI, a custom Figma to Webflow build, or visual brand assets, get a response within 24 hours.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href={`${import.meta.env.BASE_URL}contact/`}
            class="px-8 py-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 transition-all inline-flex items-center gap-2 group"
          >
            <span>Book a Scope Call</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}services/`}
            class="px-8 py-4 rounded-xl text-sm font-bold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 bg-zinc-900 dark:bg-zinc-900 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-300 hover:text-brand-400 transition-all inline-flex items-center gap-2 group"
          >
            <span>View Services & Pricing</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>

<!-- Client-side Category Filter Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const reviewCards = document.querySelectorAll('.review-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active tab button styles
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-500', 'text-white', 'shadow-lg', 'shadow-brand-500/25');
          b.classList.add('bg-zinc-900', 'text-zinc-300', 'border-zinc-800');
        });

        btn.classList.remove('bg-zinc-900', 'text-zinc-300', 'border-zinc-800');
        btn.classList.add('bg-brand-500', 'text-white', 'shadow-lg', 'shadow-brand-500/25');

        // Filter cards
        reviewCards.forEach(card => {
          const category = card.getAttribute('data-category');
          const isRepeat = card.getAttribute('data-is-repeat') === 'true';

          if (filter === 'all') {
            (card as HTMLElement).style.display = 'flex';
          } else if (filter === 'repeat') {
            (card as HTMLElement).style.display = isRepeat ? 'flex' : 'none';
          } else {
            (card as HTMLElement).style.display = category === filter ? 'flex' : 'none';
          }
        });
      });
    });
  });
</script>

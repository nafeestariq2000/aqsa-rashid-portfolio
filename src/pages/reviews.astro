// Rich Snippet JSON-LD AggregateRating Schema
const reviewSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Aqsa Rashid — Web UI/UX Design & Webflow Development Services",
  "description": "Verified client reviews and 5-star ratings for Aqsa Rashid across Web UI/UX design, Figma to Webflow builds, and brand graphics.",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "50",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": reviewsData.map((r) => ({
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating.toString(),
      "bestRating": "5"
    },
    "author": {
      "@type": "Person",
      "name": r.name
    },
    "reviewBody": r.quote
  }))
});
---

<Layout
  title="Client Reviews & Testimonials | Aqsa Rashid — Web UI/UX & Webflow Specialist"
  description="Read 100% verified client reviews and 5.0 ★ ratings for Aqsa Rashid. Discover feedback from SaaS founders, agencies, and brands on Web UI/UX design and Webflow builds."
>
  <!-- Embed JSON-LD Schema Markup -->
  <script type="application/ld+json" set:html={reviewSchema}></script>

  <Header />

  <main class="pt-28 pb-20 overflow-hidden">
    
    <!-- Hero Header Section -->
    <section class="relative py-12 md:py-16 bg-gradient-to-b from-zinc-900/50 via-zinc-950 to-zinc-950 dark:from-zinc-900/50 dark:via-zinc-950 dark:to-zinc-950 light:from-zinc-100 light:via-zinc-50 light:to-zinc-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-500/10 text-brand-400 border border-brand-500/20 mb-6">
          <span>✨</span>
          <span>VERIFIED CLIENT REVIEWS & FEEDBACK</span>
        </span>

        <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
          Trusted by Founders & Product Teams <span class="text-gradient">Worldwide</span>.
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-zinc-400 dark:text-zinc-400 light:text-zinc-600 max-w-2xl mx-auto font-normal leading-relaxed mb-12">
          100% authentic feedback from client collaborations across Web UI/UX design, Webflow development, and digital brand design contracts.
        </p>

        <!-- Stats Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto">
          {stats.map((stat) => (
            <div class="p-5 sm:p-6 rounded-3xl bg-zinc-900/90 dark:bg-zinc-900/90 light:bg-white border border-zinc-800/90 dark:border-zinc-800/90 light:border-zinc-200 shadow-xl flex flex-col items-center justify-center text-center">
              <span class="text-2xl mb-2">{stat.icon}</span>
              <span class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 tracking-tight">
                {stat.value}
              </span>
              <span class="text-xs sm:text-sm font-bold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 mt-1">
                {stat.label}
              </span>
              <span class="text-[11px] text-zinc-500 dark:text-zinc-500 light:text-zinc-400 mt-0.5 font-normal">
                {stat.subtext}
              </span>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Main Reviews Directory Section -->
    <section class="py-12 sm:py-16 bg-zinc-950 dark:bg-zinc-950 light:bg-zinc-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Category Filter Tabs Bar -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-12" id="filter-bar">
          <button
            data-filter="all"
            class="filter-btn active px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 bg-brand-500 text-white shadow-lg shadow-brand-500/25"

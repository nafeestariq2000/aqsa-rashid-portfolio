          <button
            data-filter="webflow"
            class="filter-btn px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-all duration-300 bg-zinc-900 dark:bg-zinc-900 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-400 hover:border-brand-500/40"

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="404 - Page Not Found | Aqsa Rashid UI/UX & Webflow">
  <Header />

  <main class="relative min-h-[75vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 bg-[#f8f9fc] dark:bg-[#0d0e11] overflow-hidden transition-colors duration-300">
    
    <!-- Ambient Glow Backdrops -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute top-1/3 right-1/4 w-[250px] h-[250px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>

    <div class="max-w-2xl mx-auto text-center">
      
      <!-- 404 Glassmorphic Container -->
      <div class="p-8 sm:p-12 rounded-3xl bg-white/80 dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl backdrop-blur-md">
        
        <!-- Large 404 Display Number -->
        <div class="inline-flex items-center justify-center px-6 py-2 rounded-full bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 text-xs font-extrabold uppercase tracking-widest mb-6">
          ⚠️ 404 Error: Route Not Found
        </div>

        <h1 class="font-display text-6xl sm:text-7xl font-extrabold text-zinc-900 dark:text-zinc-100 mb-4 tracking-tight">
          Lost in <span class="text-gradient">Design Space?</span>
        </h1>

        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8 max-w-lg mx-auto">
          The page or asset you are looking for has been moved, renamed, or does not exist. Let’s get you back on track!
        </p>

        <!-- Quick Navigation Links Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
          <a
            href={import.meta.env.BASE_URL}
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 hover:border-brand-500 text-zinc-900 dark:text-zinc-100 text-sm font-bold flex items-center justify-between group transition-all"
          >
            <span class="flex items-center gap-2">
              <span>🏠</span> Return to Home
            </span>
            <svg class="w-4 h-4 text-brand-500 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}services/`}
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 hover:border-brand-500 text-zinc-900 dark:text-zinc-100 text-sm font-bold flex items-center justify-between group transition-all"
          >
            <span class="flex items-center gap-2">
              <span>🚀</span> Services Overview
            </span>
            <svg class="w-4 h-4 text-brand-500 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}#work`}
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 hover:border-brand-500 text-zinc-900 dark:text-zinc-100 text-sm font-bold flex items-center justify-between group transition-all"
          >
            <span class="flex items-center gap-2">
              <span>📁</span> Selected Work
            </span>
            <svg class="w-4 h-4 text-brand-500 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>

          <a
            href={`${import.meta.env.BASE_URL}contact/`}
            class="p-4 rounded-2xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 hover:border-brand-500 text-zinc-900 dark:text-zinc-100 text-sm font-bold flex items-center justify-between group transition-all"
          >
            <span class="flex items-center gap-2">
              <span>✉️</span> Get in Touch
            </span>
            <svg class="w-4 h-4 text-brand-500 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>
        </div>

        <!-- Primary CTA Button -->
        <a
          href={import.meta.env.BASE_URL}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 transition-all"
        >
          <span>←</span> Back to Homepage
        </a>

      </div>

    </div>
  </main>

  <Footer />
</Layout>

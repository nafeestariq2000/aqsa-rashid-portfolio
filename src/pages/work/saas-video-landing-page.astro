---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import SaaSVideoHero from '../../components/work/SaaSVideoHero.astro';
import SaaSVideoProblem from '../../components/work/SaaSVideoProblem.astro';
import SaaSVideoProcess from '../../components/work/SaaSVideoProcess.astro';
import SaaSVideoDesignSystem from '../../components/work/SaaSVideoDesignSystem.astro';
import SaaSVideoResults from '../../components/work/SaaSVideoResults.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Selected Work",
      "item": "https://aqsarashid.com/#work"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "SaaS Video Editor UI Case Study",
      "item": "https://aqsarashid.com/work/saas-video-landing-page/"
    }
  ]
});

const caseStudySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "Create Video Instantly — AI SaaS Video Editor Landing Page UI",
  "author": {
    "@type": "Person",
    "name": "Aqsa Rashid"
  },
  "headline": "Redesigning an AI SaaS Landing Page to Boost Free Trial Conversions by +35%",
  "about": "Figma Web UI/UX Design & Landing Page Optimization Case Study",
  "genre": "UI/UX Design Case Study"
});

const relatedLinks = [
  {
    title: "Web UI/UX Design Services",
    subtitle: "Explore full capabilities for Figma landing page wireframing, component design systems, & prototypes.",
    url: `${import.meta.env.BASE_URL}services/figma-ui-ux-design/`,
    badge: "Corresponding Service",
    icon: "❖"
  },
  {
    title: "Solar Energy Webflow System Case Study",
    subtitle: "See how an end-to-end Figma to Webflow CMS build generated +210% consultations.",
    url: `${import.meta.env.BASE_URL}work/solar-energy-website/`,
    badge: "Next Case Study",
    icon: "⚡"
  },
  {
    title: "Services Overview Hub",
    subtitle: "Compare all 3 core service offerings, deliverables, turnarounds, and pricing matrix.",
    url: `${import.meta.env.BASE_URL}services/`,
    badge: "Services Hub",
    icon: "🚀"
  }
];
---

<Layout
  title="SaaS Video Editor UI Case Study | Figma Landing Page Redesign — Aqsa Rashid"
  description="Explore the UI/UX case study for AI Video Startup CreateVideo Instantly. Discover how Google UX principles, wireframing, and Figma design systems drove +35% higher conversions."
  image={`${import.meta.env.BASE_URL}images/portfolio/cover-velox-video.png`}
  ogType="article"
>
  <!-- Embed Schema Markup -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>
  <script type="application/ld+json" set:html={caseStudySchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Banner & Case Study Overview -->
    <SaaSVideoHero />

    <!-- Section 2: Problem vs. Solution -->
    <SaaSVideoProblem />

    <!-- Section 3: 4-Phase Google UX Process -->
    <SaaSVideoProcess />

    <!-- Section 4: Figma Design System Showcase -->
    <SaaSVideoDesignSystem />

    <!-- Section 5: Measurable Results & Client Testimonial -->
    <SaaSVideoResults />

    <!-- Section 6: Related Internal Links -->
    <RelatedLinks
      heading="Explore Next Case Study & Related Services"
      links={relatedLinks}
    />

    <!-- Section 7: Direct Project Contact & Booking -->
    <Contact />
  </main>

  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import GymBrandingHero from '../../components/work/GymBrandingHero.astro';
import GymBrandingProblem from '../../components/work/GymBrandingProblem.astro';
import GymBrandingStrategy from '../../components/work/GymBrandingStrategy.astro';
import GymBrandingShowcase from '../../components/work/GymBrandingShowcase.astro';
import GymBrandingResults from '../../components/work/GymBrandingResults.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://aqsarashid.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Selected Work",
      "item": "https://aqsarashid.com/#work"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Fitness Gym Social Media Branding Case Study",
      "item": "https://aqsarashid.com/work/fitness-social-media-branding/"
    }
  ]
});

const caseStudySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "Apex Fitness Club — High-Impact Gym Social Media & Brand Campaign",
  "author": {
    "@type": "Person",
    "name": "Aqsa Rashid"
  },
  "headline": "Crafting a High-Contrast Social Campaign to Drive +450% Engagement Reach",
  "about": "Social Media Branding & Instagram Carousel Case Study",
  "genre": "Visual Branding Case Study"
});

const relatedLinks = [
  {
    title: "Social Media & Brand Designer Services",
    subtitle: "Discover creative offerings for 1080x1350 carousels, ad visual banners, & brand identity guides.",
    url: `${import.meta.env.BASE_URL}services/social-media-design/`,
    badge: "Corresponding Service",
    icon: "🎨"
  },
  {
    title: "SaaS Video Platform UI Case Study",
    subtitle: "Explore how Google UX wireframes & Figma prototypes drove +35% higher trial conversions.",
    url: `${import.meta.env.BASE_URL}work/saas-video-landing-page/`,
    badge: "Featured UI Case Study",
    icon: "📁"
  },
  {
    title: "Services Overview Hub",
    subtitle: "Compare all 3 core service offerings, deliverables, turnarounds, and pricing matrix.",
    url: `${import.meta.env.BASE_URL}services/`,
    badge: "Services Hub",
    icon: "🚀"
  }
];
---

<Layout
  title="Fitness Gym Social Media Branding Case Study | Instagram Carousels — Aqsa Rashid"
  description="Explore the visual branding case study for Apex Fitness Club. Discover how high-contrast Instagram carousels and ad creatives drove +450% higher engagement reach."
  image={`${import.meta.env.BASE_URL}images/portfolio/cover-gym-branding.png`}
  ogType="article"
>
  <!-- Embed Schema Markup -->
  <script type="application/ld+json" set:html={breadcrumbSchema}></script>
  <script type="application/ld+json" set:html={caseStudySchema}></script>

  <Header />
  
  <main class="flex-grow">
    <!-- Section 1: Hero Banner & Case Study Overview -->
    <GymBrandingHero />

    <!-- Section 2: Problem vs. Solution -->
    <GymBrandingProblem />

    <!-- Section 3: 4-Phase Creative Strategy -->
    <GymBrandingStrategy />

    <!-- Section 4: Brand Asset & Deliverables Showcase -->
    <GymBrandingShowcase />

    <!-- Section 5: Campaign Impact, Metrics & Testimonial -->
    <GymBrandingResults />

    <!-- Section 6: Related Internal Links -->
    <RelatedLinks
      heading="Explore Next Case Study & Related Services"
      links={relatedLinks}
    />

    <!-- Section 7: Contact CTA -->
    <Contact />
  </main>

  <Footer />
</Layout>

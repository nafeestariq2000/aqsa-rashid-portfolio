---
const highlights = [
  {
    icon: "🎨",
    title: "User-Centered Approach",
    desc: "Wireframing, accessibility, and intuitive user flows certified by Google UX Design methodology."
  },
  {
    icon: "⚡",
    title: "Seamless Webflow Handoff",
    desc: "Translating Figma auto-layouts into clean, responsive Webflow sites using Client-First conventions."
  },
  {
    icon: "📱",
    title: "Cross-Channel Consistency",
    desc: "Maintaining visual brand identity across landing pages, Instagram carousels, and ad creatives."
  }
];
---

<section id="about" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left Column: Visual Highlight Card -->
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="relative p-6 sm:p-8 rounded-3xl bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 shadow-2xl">
          
          <!-- Decorative Top Glow -->
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex items-center gap-4 pb-6 border-b border-zinc-800 dark:border-zinc-800 light:border-zinc-100">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white font-bold text-2xl shadow-lg shadow-brand-500/20">
              UX
            </div>
            <div>
              <h3 class="font-display font-bold text-lg text-zinc-100 dark:text-zinc-100 light:text-zinc-900">
                Google UX Certified
              </h3>
              <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
                Specialization ID: SH3P98LARDNQ
              </p>
            </div>
          </div>

          <!-- Certificate Highlights -->
          <div class="py-6 space-y-4">
            <div class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base mt-0.5">✓</span>
              <div>
                <p class="text-sm font-semibold text-zinc-200 dark:text-zinc-200 light:text-zinc-800">Empathy & User Research</p>
                <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">Conducting user interviews & persona mapping</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base mt-0.5">✓</span>
              <div>
                <p class="text-sm font-semibold text-zinc-200 dark:text-zinc-200 light:text-zinc-800">Low & High-Fidelity Prototyping</p>
                <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">Wireframes to interactive Figma prototypes</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-base mt-0.5">✓</span>
              <div>
                <p class="text-sm font-semibold text-zinc-200 dark:text-zinc-200 light:text-zinc-800">Accessibility & Inclusivity</p>
                <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">WCAG 2.1 AA contrast & navigation standards</p>
              </div>
            </div>
          </div>

          <!-- Bottom University Badge -->
          <div class="pt-4 border-t border-zinc-800 dark:border-zinc-800 light:border-zinc-100 flex items-center justify-between text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
            <span>Univ. of Colorado Boulder</span>
            <span class="text-brand-400 font-semibold">Branding & UX</span>
          </div>

        </div>
      </div>

      <!-- Right Column: Story Copy & Strengths -->
      <div class="lg:col-span-7 order-1 lg:order-2 flex flex-col items-start text-left">
        
        <span class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-3">
          ABOUT AQSA RASHID
        </span>

        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 leading-tight mb-6">
          Turning Ideas Into Simple, Beautiful & <span class="text-gradient">User-Centric</span> Web Experiences.
        </h2>

        <div class="space-y-4 text-base sm:text-lg text-zinc-300 dark:text-zinc-300 light:text-zinc-600 leading-relaxed mb-8">
          <p>
            Hi, I’m <strong class="text-zinc-100 dark:text-zinc-100 light:text-zinc-900">Aqsa Rashid</strong> — a Web UI/UX Designer, Figma Specialist, and Webflow Developer based in Karachi, Pakistan, servicing global remote clients.
          </p>
          <p>
            I don't just create pretty screens; I build digital experiences backed by <strong class="text-brand-400">Google UX Design principles</strong>. Whether you're a startup founder launching a new SaaS product, a business owner needing a high-converting landing page, or a brand seeking consistent social media creatives, I craft clean, intuitive visuals tailored to your audience.
          </p>
          <p>
            From initial wireframes and design systems in Figma to pixel-perfect, responsive development in Webflow, I ensure your digital presence looks stunning and drives real business growth.
          </p>
        </div>

        <!-- Strengths Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 w-full">
          {highlights.map((item) => (
            <div class="p-4 rounded-2xl bg-zinc-900/50 dark:bg-zinc-900/50 light:bg-zinc-100/80 border border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200">
              <div class="text-2xl mb-2">{item.icon}</div>
              <h4 class="font-display text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-1">
                {item.title}
              </h4>
              <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500 leading-normal">
                {item.desc}
              </p>
            </div>
          ))}
        </div>

      </div>

    </div>

  </div>
</section>

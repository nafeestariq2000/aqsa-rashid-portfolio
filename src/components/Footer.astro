---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 bg-zinc-950 dark:bg-zinc-950 light:bg-zinc-100 py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-8 border-b border-zinc-800/60 dark:border-zinc-800/60 light:border-zinc-200">
      
      <!-- Brand & Tagline -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <a href="#" class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white font-bold font-display text-sm">
            AR
          </div>
          <span class="font-display font-extrabold text-lg text-zinc-100 dark:text-zinc-100 light:text-zinc-900 tracking-tight">
            AQSA RASHID
          </span>
        </a>
        <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
          Google UX Certified Web UI/UX Designer & Webflow Specialist
        </p>
      </div>

      <!-- Footer Quick Navigation Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6 text-xs font-semibold text-zinc-400 dark:text-zinc-400 light:text-zinc-600">
        <a href="#about" class="hover:text-brand-400 transition-colors">About</a>
        <a href="#services" class="hover:text-brand-400 transition-colors">Services</a>
        <a href="#process" class="hover:text-brand-400 transition-colors">Process</a>
        <a href="#work" class="hover:text-brand-400 transition-colors">Work</a>
        <a href="#reviews" class="hover:text-brand-400 transition-colors">Reviews</a>
        <a href="#faq" class="hover:text-brand-400 transition-colors">FAQ</a>
        <a href="#contact" class="hover:text-brand-400 transition-colors">Contact</a>
      </nav>

      <!-- Back To Top Button -->
      <a
        href="#"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-300 hover:border-brand-500 hover:text-brand-400 transition-all duration-300"
      >
        Back to Top ↑
      </a>

    </div>

    <!-- Copyright Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
      <p>© {currentYear} Aqsa Rashid. All Rights Reserved.</p>
      <p class="flex items-center gap-1">
        <span>Designed with</span>
        <span class="text-brand-500">❤️</span>
        <span>& Google UX Principles</span>
      </p>
    </div>

  </div>
</footer>

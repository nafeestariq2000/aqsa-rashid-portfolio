---
const currentYear = new Date().getFullYear();

const socials = [
  {
    name: "LinkedIn Profile",
    url: "https://www.linkedin.com/in/hi-aqsarashid",
    baseColor: "bg-[#0A66C2]/10 border-[#0A66C2]/30 text-[#0A66C2]",
    hoverColor: "hover:bg-[#0A66C2] hover:border-[#0A66C2] hover:text-white hover:shadow-lg hover:shadow-[#0A66C2]/25",
    iconSvg: `<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>`
  },
  {
    name: "Behance Portfolio",
    url: "https://www.behance.net/aqsarashid2",
    baseColor: "bg-[#0057FF]/10 border-[#0057FF]/30 text-[#0057FF]",
    hoverColor: "hover:bg-[#0057FF] hover:border-[#0057FF] hover:text-white hover:shadow-lg hover:shadow-[#0057FF]/25",
    iconSvg: `<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22 7h-7V5h7v2zm-1.7 6c0-2.4-1.7-4-4.3-4-2.7 0-4.6 1.8-4.6 4.5 0 2.8 1.9 4.5 4.7 4.5 2.1 0 3.7-1 4.2-2.6h-2.1c-.3.7-1.1 1.1-2.1 1.1-1.3 0-2.3-.8-2.5-2.1h6.6c.1-.5.1-.9.1-1.4zm-4.3-2.3c1.2 0 2.1.7 2.3 1.8h-4.6c.2-1.1 1.1-1.8 2.3-1.8zM10.1 13c.7-.4 1.2-1.1 1.2-2.1 0-1.8-1.4-2.9-3.6-2.9H2v10h5.9c2.3 0 3.8-1.2 3.8-3.2 0-1.1-.6-1.7-1.6-1.8zm-5.4-3.3h2.8c.9 0 1.5.5 1.5 1.2 0 .8-.6 1.3-1.5 1.3H4.7V9.7zm3.1 6.6H4.7v-2.7h3.1c1 0 1.7.5 1.7 1.3 0 .9-.7 1.4-1.7 1.4z"/></svg>`
  },
  {
    name: "Direct Email",
    url: "mailto:hi.aqsarashid@gmail.com",
    baseColor: "bg-brand-500/10 border-brand-500/30 text-brand-500",
    hoverColor: "hover:bg-brand-500 hover:border-brand-500 hover:text-white hover:shadow-lg hover:shadow-brand-500/25",
    iconSvg: `<svg class="w-4 h-4 fill-none stroke-current stroke-2 stroke-linecap-round stroke-linejoin-round" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`
  }
];
---

<footer class="border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 bg-zinc-950 dark:bg-zinc-950 light:bg-zinc-100 pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-zinc-800/60 dark:border-zinc-800/60 light:border-zinc-200">
      
      <!-- Col 1: Brand Info & Official Social Icons (4 cols) -->
      <div class="lg:col-span-4 lg:pr-8 flex flex-col justify-between">
        <div>
          <a href={import.meta.env.BASE_URL} class="flex items-center gap-3 mb-4 group">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-400 via-brand-500 to-brand-600 flex items-center justify-center text-white font-bold font-display text-lg shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform duration-300">
              AR
            </div>
            <span class="font-display font-extrabold text-xl text-zinc-100 dark:text-zinc-100 light:text-zinc-900 tracking-tight group-hover:text-brand-500 transition-colors">
              AQSA RASHID
            </span>
          </a>

          <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-400 light:text-zinc-600 font-normal leading-relaxed mb-6 max-w-sm">
            Google UX Certified Web UI/UX Designer & Webflow Developer crafting high-converting landing pages, design systems, and digital experiences.
          </p>
        </div>

        <!-- Official Social Media Icons in Brand Colors -->
        <div class="flex items-center gap-3 pt-2">
          {socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              title={s.name}
              aria-label={s.name}
              class={`w-10 h-10 rounded-xl border flex items-center justify-center transition-all duration-300 ${s.baseColor} ${s.hoverColor}`}
              set:html={s.iconSvg}
            />
          ))}
        </div>
      </div>

      <!-- Col 2: Core Services (3 cols) -->
      <div class="lg:col-span-3">
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-4">
          Core Services
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-600">
          <li>
            <a href={`${import.meta.env.BASE_URL}services/`} class="hover:text-brand-400 transition-colors block">
              Services Overview Hub
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}services/figma-ui-ux-design/`} class="hover:text-brand-400 transition-colors block">
              Web UI/UX Design
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}services/figma-to-webflow/`} class="hover:text-brand-400 transition-colors block">
              Figma to Webflow
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}services/social-media-design/`} class="hover:text-brand-400 transition-colors block">
              Social Media Design
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Selected Work & Case Studies (3 cols) -->
      <div class="lg:col-span-3">
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-4">
          Case Studies
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-600">
          <li>
            <a href={`${import.meta.env.BASE_URL}#work`} class="hover:text-brand-400 transition-colors block">
              Selected Work Gallery
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}work/saas-video-landing-page/`} class="hover:text-brand-400 transition-colors block">
              AI SaaS Platform UI
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}work/solar-energy-website/`} class="hover:text-brand-400 transition-colors block">
              Solar Webflow System
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}work/fitness-social-media-branding/`} class="hover:text-brand-400 transition-colors block">
              Apex Gym Branding
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Explore & Contact (2 cols) -->
      <div class="lg:col-span-2">
        <h4 class="font-display text-sm font-bold uppercase tracking-wider text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-4">
          Explore
        </h4>
        <ul class="space-y-2.5 text-xs sm:text-sm font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-600">
          <li>
            <a href={`${import.meta.env.BASE_URL}about/`} class="hover:text-brand-400 transition-colors block">
              About Aqsa
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}#reviews`} class="hover:text-brand-400 transition-colors block">
              Testimonials
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}#faq`} class="hover:text-brand-400 transition-colors block">
              FAQ
            </a>
          </li>
          <li>
            <a href={`${import.meta.env.BASE_URL}contact/`} class="hover:text-brand-400 transition-colors block">
              Contact
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright & Back To Top Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
      <p>© {currentYear} Aqsa Rashid. All Rights Reserved.</p>

      <!-- Back To Top Button -->
      <a
        href="#"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 bg-zinc-900 dark:bg-zinc-900 light:bg-white border border-zinc-800 dark:border-zinc-800 light:border-zinc-300 hover:border-brand-500 hover:text-brand-400 transition-all duration-300 group"
      >
        <span>Back to Top</span>
        <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19V5m0 0l-7 7m7-7l7 7"></path>
        </svg>
      </a>
    </div>

  </div>
</footer>

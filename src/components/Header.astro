---
const servicesDropdown = [
  {
    title: "Services Overview Hub",
    subtitle: "Explore all 3 core service categories & pricing matrix",
    url: `${import.meta.env.BASE_URL}services/`,
    icon: "🚀",
    badge: "Hub Overview"
  },
  {
    title: "Web UI/UX Design",
    subtitle: "Figma wireframes, prototypes & scalable design systems",
    url: `${import.meta.env.BASE_URL}services/figma-ui-ux-design/`,
    icon: "❖",
    badge: "Figma UI"
  },
  {
    title: "Figma to Webflow",
    subtitle: "Client-First BEM class builds with 100/100 Web Vitals",
    url: `${import.meta.env.BASE_URL}services/figma-to-webflow/`,
    icon: "⚡",
    badge: "Webflow"
  },
  {
    title: "Social Media Design",
    subtitle: "1080x1350 Instagram carousels & promotional ad graphics",
    url: `${import.meta.env.BASE_URL}services/social-media-design/`,
    icon: "✨",
    badge: "Branding"
  }
];

const workDropdown = [
  {
    title: "Selected Work Gallery",
    subtitle: "Browse all client projects with filterable category tabs",
    url: `${import.meta.env.BASE_URL}#work`,
    icon: "📁",
    badge: "All Projects"
  },
  {
    title: "AI SaaS Video Platform",
    subtitle: "+35% Conversion Intent Figma landing page case study",
    url: `${import.meta.env.BASE_URL}work/saas-video-landing-page/`,
    icon: "🖥️",
    badge: "UI Case Study"
  },
  {
    title: "Solar Energy Website",
    subtitle: "+210% Consultation bookings Webflow CMS build",
    url: `${import.meta.env.BASE_URL}work/solar-energy-website/`,
    icon: "⚡",
    badge: "Webflow Study"
  },
  {
    title: "Apex Gym Social Branding",
    subtitle: "+450% Engagement Instagram carousel campaign",
    url: `${import.meta.env.BASE_URL}work/fitness-social-media-branding/`,
    icon: "🎨",
    badge: "Brand Study"
  }
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#0d0e11]/90 dark:bg-[#0d0e11]/90 light:bg-white/90 border-b border-white/5 dark:border-white/5 light:border-black/5 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href={import.meta.env.BASE_URL} class="group flex items-center gap-3 focus:outline-none">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-400 via-brand-500 to-brand-600 flex items-center justify-center text-white font-bold font-display text-xl shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform duration-300">
        AR
      </div>
      <div class="flex flex-col">
        <span class="font-display font-bold text-lg text-zinc-100 dark:text-zinc-100 light:text-zinc-900 tracking-tight leading-tight group-hover:text-brand-500 transition-colors">
          AQSA RASHID
        </span>
        <span class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500 font-medium">
          Web UI & Webflow Specialist
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links with Interactive Dropdowns -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-300 dark:text-zinc-300 light:text-zinc-700">
      
      <a href={`${import.meta.env.BASE_URL}about/`} class="hover:text-brand-500 transition-colors py-2">About</a>

      <!-- Services Dropdown -->
      <div class="relative group">
        <a
          href={`${import.meta.env.BASE_URL}services/`}
          class="flex items-center gap-1.5 hover:text-brand-500 transition-colors py-6 cursor-pointer"
        >
          <span>Services</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-brand-500 group-hover:rotate-180 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </a>

        <!-- Services Dropdown Card -->
        <div class="absolute top-full left-0 w-80 p-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl shadow-black/20 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-2 group-hover:translate-y-0 transition-all duration-200 z-50">
          <div class="space-y-1">
            {servicesDropdown.map((item) => (
              <a
                href={item.url}
                class="p-3 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800/80 flex items-start gap-3 transition-colors group/item"
              >
                <div class="w-9 h-9 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center font-bold text-base shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                  {item.icon}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover/item:text-brand-500 transition-colors">
                      {item.title}
                    </span>
                  </div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 font-normal leading-snug">
                    {item.subtitle}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Work Dropdown -->
      <div class="relative group">
        <a
          href={`${import.meta.env.BASE_URL}#work`}
          class="flex items-center gap-1.5 hover:text-brand-500 transition-colors py-6 cursor-pointer"
        >
          <span>Work</span>
          <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-brand-500 group-hover:rotate-180 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </a>

        <!-- Work Dropdown Card -->
        <div class="absolute top-full left-0 w-80 p-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl shadow-black/20 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-2 group-hover:translate-y-0 transition-all duration-200 z-50">
          <div class="space-y-1">
            {workDropdown.map((item) => (
              <a
                href={item.url}
                class="p-3 rounded-xl hover:bg-zinc-100 dark:hover:bg-zinc-800/80 flex items-start gap-3 transition-colors group/item"
              >
                <div class="w-9 h-9 rounded-lg bg-brand-500/10 text-brand-500 flex items-center justify-center font-bold text-base shrink-0 mt-0.5 group-hover/item:scale-110 transition-transform">
                  {item.icon}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover/item:text-brand-500 transition-colors">
                      {item.title}
                    </span>
                  </div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 font-normal leading-snug">
                    {item.subtitle}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href={`${import.meta.env.BASE_URL}reviews/`} class="hover:text-brand-500 transition-colors py-2">Reviews</a>
      <a href={`${import.meta.env.BASE_URL}#faq`} class="hover:text-brand-500 transition-colors py-2">FAQ</a>
      <a href={`${import.meta.env.BASE_URL}contact/`} class="hover:text-brand-500 transition-colors py-2">Contact</a>
    </nav>

    <!-- Header Right Actions & Mobile Toggle -->
    <div class="flex items-center gap-3 sm:gap-4">
      
      <!-- Dark/Light Theme Toggle -->
      <button
        onclick="window.toggleTheme()"
        aria-label="Toggle dark/light mode"
        class="p-2.5 rounded-xl border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 bg-zinc-900/60 dark:bg-zinc-900/60 light:bg-zinc-100 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-500 hover:border-brand-500/40 transition-all duration-300"
      >
        <!-- Moon icon for light mode -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden dark:block text-brand-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path><path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path><path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Sun icon for dark mode -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 block dark:hidden text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Action CTA Button -->
      <a
        href={`${import.meta.env.BASE_URL}contact/`}
        class="hidden sm:inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 group"
      >
        <span>Book a Call</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>

      <!-- Mobile Hamburger Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Open Navigation Menu"
        class="md:hidden p-2.5 rounded-xl border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 bg-zinc-900/60 dark:bg-zinc-900/60 light:bg-zinc-100 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-500 transition-colors"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-800/80 bg-zinc-950/95 dark:bg-zinc-950/95 light:bg-white/95 backdrop-blur-xl px-4 pt-4 pb-6 space-y-4">
    
    <a href={`${import.meta.env.BASE_URL}about/`} class="block py-2 text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 hover:text-brand-500">
      About Aqsa
    </a>

    <!-- Mobile Services Accordion -->
    <div class="space-y-2 pt-2 border-t border-zinc-800/60">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-500">Services & Offerings:</p>
      {servicesDropdown.map((item) => (
        <a href={item.url} class="flex items-center gap-2.5 py-1.5 text-xs font-semibold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-400">
          <span>{item.icon}</span>
          <span>{item.title}</span>
        </a>
      ))}
    </div>

    <!-- Mobile Work Accordion -->
    <div class="space-y-2 pt-2 border-t border-zinc-800/60">
      <p class="text-xs font-bold uppercase tracking-wider text-brand-500">Selected Case Studies:</p>
      {workDropdown.map((item) => (
        <a href={item.url} class="flex items-center gap-2.5 py-1.5 text-xs font-semibold text-zinc-300 dark:text-zinc-300 light:text-zinc-700 hover:text-brand-400">
          <span>{item.icon}</span>
          <span>{item.title}</span>
        </a>
      ))}
    </div>

    <div class="pt-2 border-t border-zinc-800/60 flex flex-col gap-3">
      <a href={`${import.meta.env.BASE_URL}contact/`} class="w-full py-3 rounded-xl text-xs font-bold text-center text-white bg-brand-500 flex items-center justify-center gap-1.5 group">
        <span>Book a Scope Call</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>
    </div>

  </div>

  <script is:inline>
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
</header>

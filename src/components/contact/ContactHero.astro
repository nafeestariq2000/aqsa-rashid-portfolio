---
---

<section class="relative pt-12 pb-12 md:pt-16 md:pb-20 overflow-hidden bg-white dark:bg-[#0d0e11] transition-colors duration-300 border-b border-zinc-200/80 dark:border-zinc-800/80">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[260px] h-[260px] bg-amber-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-brand-600 dark:text-brand-400 font-bold">Contact</span>
    </nav>

    <div class="max-w-3xl flex flex-col items-start text-left">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Available for Remote Contracts & Freelance
      </div>

      <!-- Main H1 Headline -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
        Let's Start Your <span class="text-gradient">Next Project</span>.
      </h1>

      <!-- Sub-headline -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed mb-6">
        Have a new Web UI/UX design project, Figma-to-Webflow conversion, or social media branding campaign in mind? Send a message below or connect directly on social channels.
      </p>

      <!-- Response Time Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/80 text-xs font-bold text-zinc-700 dark:text-zinc-300">
        <span>⚡</span> Direct response within 24 hours guaranteed.
      </div>

    </div>

  </div>
</section>

---

<section id="reviews" class="py-20 md:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs sm:text-sm font-bold uppercase tracking-widest text-brand-400 mb-3">
        CLIENT TESTIMONIALS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 leading-tight mb-4">
        Trusted by Founders, Brands & <span class="text-gradient">Agencies Worldwide</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-400 dark:text-zinc-400 light:text-zinc-600">
        Over 50+ completed international orders with a 5.0 ★★★★★ rating across direct client & agency contracts.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((item) => (
        <div class="relative p-8 rounded-3xl bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 shadow-xl flex flex-col justify-between hover:border-brand-500/40 transition-all duration-300">
          
          <div>
            <!-- Stars & Watermark Quote -->
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-1 text-amber-400 text-lg">
                ★★★★★
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-brand-500/10 text-brand-400 border border-brand-500/20">
                {item.tag}
              </span>
            </div>

            <!-- Quote Text -->
            <p class="text-sm text-zinc-300 dark:text-zinc-300 light:text-zinc-700 leading-relaxed italic mb-8">
              "{item.quote}"
            </p>
          </div>

          <!-- Client Footer Info -->
          <div class="pt-6 border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-400 to-amber-500 flex items-center justify-center text-white font-bold text-sm">
                {item.name.charAt(0)}
              </div>
              <div>
                <p class="text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900">
                  {item.name}
                </p>
                <p class="text-xs text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
                  {item.flag} {item.location}
                </p>
              </div>
            </div>
            
            <span class="text-xs font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-500">
              {item.project}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

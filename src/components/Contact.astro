---
---

<section id="contact" class="py-20 md:py-28 relative">
  <!-- Subtle Glow Effect -->
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- Left Column: Contact Copy & Direct Channels -->
      <div class="lg:col-span-5 flex flex-col items-start text-left">
        
        <span class="text-xs font-bold uppercase tracking-widest text-brand-400 mb-3">
          LET'S CONNECT
        </span>

        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 leading-tight mb-6">
          Have an Awesome Project Idea? <span class="text-gradient">Let’s Discuss</span>.
        </h2>

        <p class="text-base sm:text-lg text-zinc-400 dark:text-zinc-400 light:text-zinc-600 leading-relaxed mb-8">
          Whether you need a custom Figma landing page, a Webflow site conversion, or high-engagement social media graphics, I'm ready to bring your vision to life.
        </p>

        <!-- Direct Contact Cards -->
        <div class="space-y-4 w-full mb-10">
          
          <!-- Direct Email Card -->
          <a
            href="mailto:hi.aqsarashid@gmail.com"
            class="group p-4 rounded-2xl bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 hover:border-brand-500/50 flex items-center gap-4 transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              ✉️
            </div>
            <div>
              <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-400 light:text-zinc-500">Direct Email</p>
              <p class="text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 group-hover:text-brand-400 transition-colors">
                hi.aqsarashid@gmail.com
              </p>
            </div>
          </a>

          <!-- WhatsApp Direct Card -->
          <a
            href="https://wa.me/923323773369"
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 rounded-2xl bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-white border border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200 hover:border-emerald-500/50 flex items-center gap-4 transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
              💬
            </div>
            <div>
              <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-400 light:text-zinc-500">WhatsApp / Direct Line</p>
              <p class="text-sm font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 group-hover:text-emerald-400 transition-colors">
                +92 332 3773369
              </p>
            </div>
          </a>

        </div>

        <!-- Social Profiles Bar -->
        <div class="w-full pt-6 border-t border-zinc-800/80 dark:border-zinc-800/80 light:border-zinc-200">
          <p class="text-xs font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-400 light:text-zinc-500 mb-3">
            Find Me On:
          </p>
          <div class="flex items-center gap-3">
            <a
              href="https://www.linkedin.com/in/hi-aqsarashid"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900/90 dark:bg-zinc-900/90 light:bg-zinc-100 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 hover:text-brand-400 hover:border-brand-500/40 transition-all"
            >
              LinkedIn ↗
            </a>
            <a
              href="https://www.behance.net/aqsarashid2"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900/90 dark:bg-zinc-900/90 light:bg-zinc-100 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 hover:text-brand-400 hover:border-brand-500/40 transition-all"
            >
              Behance ↗
            </a>
            <a
              href="https://www.fiverr.com/aqsa_rashid115"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-900/90 dark:bg-zinc-900/90 light:bg-zinc-100 text-zinc-300 dark:text-zinc-300 light:text-zinc-700 border border-zinc-800 dark:border-zinc-800 light:border-zinc-200 hover:text-brand-400 hover:border-brand-500/40 transition-all"
            >
              Fiverr Profile ↗
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-zinc-900/90 dark:bg-zinc-900/90 light:bg-white border border-zinc-800/90 dark:border-zinc-800/90 light:border-zinc-200 shadow-2xl">
          
          <h3 class="font-display text-xl sm:text-2xl font-bold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 mb-6">
            Send Me a Message
          </h3>

          <form action="https://formspree.io/f/mqakvjpl" method="POST" class="space-y-6" id="contact-form">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Name Input -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 dark:text-zinc-300 light:text-zinc-700 mb-2">
                  Your Full Name *
                </label>
                <input
                  type="text"
                  name="name"
                  required
                  placeholder="e.g. Sarah Jenkins"
                  class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/50 dark:bg-zinc-800/50 light:bg-zinc-50 border border-zinc-700/60 dark:border-zinc-700/60 light:border-zinc-300 text-zinc-100 dark:text-zinc-100 light:text-zinc-900 placeholder-zinc-500 focus:outline-none focus:border-brand-500 transition-colors text-sm"
                />
              </div>

              <!-- Email Input -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 dark:text-zinc-300 light:text-zinc-700 mb-2">
                  Your Email Address *
                </label>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder="e.g. sarah@company.com"
                  class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/50 dark:bg-zinc-800/50 light:bg-zinc-50 border border-zinc-700/60 dark:border-zinc-700/60 light:border-zinc-300 text-zinc-100 dark:text-zinc-100 light:text-zinc-900 placeholder-zinc-500 focus:outline-none focus:border-brand-500 transition-colors text-sm"
                />
              </div>
            </div>

            <!-- Service Selector Dropdown -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 dark:text-zinc-300 light:text-zinc-700 mb-2">
                Service Required *
              </label>
              <select
                name="service"
                required
                class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/50 dark:bg-zinc-800/50 light:bg-zinc-50 border border-zinc-700/60 dark:border-zinc-700/60 light:border-zinc-300 text-zinc-100 dark:text-zinc-100 light:text-zinc-900 focus:outline-none focus:border-brand-500 transition-colors text-sm"
              >
                <option value="Figma Web UI/UX Design" class="bg-zinc-900 dark:bg-zinc-900 light:bg-white text-zinc-100 dark:text-zinc-100 light:text-zinc-900">Figma Web UI/UX Design</option>
                <option value="Figma to Webflow Development" class="bg-zinc-900 dark:bg-zinc-900 light:bg-white text-zinc-100 dark:text-zinc-100 light:text-zinc-900">Figma to Webflow Development</option>
                <option value="Social Media & Brand Design" class="bg-zinc-900 dark:bg-zinc-900 light:bg-white text-zinc-100 dark:text-zinc-100 light:text-zinc-900">Social Media & Brand Design</option>
                <option value="Full Package / Custom Request" class="bg-zinc-900 dark:bg-zinc-900 light:bg-white text-zinc-100 dark:text-zinc-100 light:text-zinc-900">Full Package / Custom Request</option>
              </select>
            </div>

            <!-- Project Message Details -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-zinc-300 dark:text-zinc-300 light:text-zinc-700 mb-2">
                Project Details & Timeline *
              </label>
              <textarea
                name="message"
                rows="4"
                required
                placeholder="Tell me about your project goals, scope, and estimated timeline..."
                class="w-full px-4 py-3.5 rounded-xl bg-zinc-800/50 dark:bg-zinc-800/50 light:bg-zinc-50 border border-zinc-700/60 dark:border-zinc-700/60 light:border-zinc-300 text-zinc-100 dark:text-zinc-100 light:text-zinc-900 placeholder-zinc-500 focus:outline-none focus:border-brand-500 transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full py-4 px-6 rounded-xl font-bold text-white text-base bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 flex items-center justify-center gap-2"
            >
              Send Inquiry ↗
            </button>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

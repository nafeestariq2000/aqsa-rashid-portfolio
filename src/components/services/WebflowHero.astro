---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Subtle Ambient Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-brand-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-zinc-400 dark:text-zinc-500">Services</span>
      <span>/</span>
      <span class="text-brand-600 dark:text-brand-400 font-bold">Figma to Webflow</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
          Pixel-Perfect Webflow Development Specialist
        </div>

        <!-- Main H1 Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
          Seamless Figma to <span class="text-gradient">Webflow Development</span> & Build.
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed mb-8 max-w-2xl">
          Transform your custom Figma design layouts into lightning-fast, fully responsive, SEO-optimized Webflow websites built using Relume & Client-First class architecture for effortless content management.
        </p>

        <!-- Key Technical Capabilities Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full mb-10 text-xs font-bold text-zinc-700 dark:text-zinc-300">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-blue-500 text-base">⚡</span>
            <span>Client-First Naming</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-emerald-500 text-base">🚀</span>
            <span>100/100 Web Vitals</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm col-span-2 sm:col-span-1">
            <span class="text-brand-500 text-base">🗂️</span>
            <span>Custom Webflow CMS</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
          >
            Start Webflow Build
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
          </a>

          <a
            href="#features"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-zinc-700 dark:text-zinc-200 bg-white dark:bg-zinc-900/80 border border-zinc-300 dark:border-zinc-800 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 transition-all duration-300 shadow-sm"
          >
            Webflow Specs ↓
          </a>
        </div>

      </div>

      <!-- Right Column: Webflow Designer Interface Simulation Mockup -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-8 lg:mt-0">
        
        <!-- Webflow Canvas UI Frame -->
        <div class="relative w-full max-w-md p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl">
          
          <!-- Webflow Header Bar -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-blue-600 text-white font-bold flex items-center justify-center text-xs">
                W
              </div>
              <span class="text-xs font-bold text-zinc-800 dark:text-zinc-200 font-mono">Webflow Designer</span>
            </div>
            <!-- Breakpoint Switchers -->
            <div class="flex items-center gap-1.5 p-1 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-[10px] font-bold text-zinc-600 dark:text-zinc-400">
              <span class="px-2 py-0.5 rounded bg-white dark:bg-zinc-700 text-blue-600 dark:text-blue-400 shadow-xs">1440px</span>
              <span class="px-1.5 py-0.5">768px</span>
              <span class="px-1.5 py-0.5">375px</span>
            </div>
          </div>

          <!-- Webflow DOM Navigator & Style Panel -->
          <div class="space-y-3 bg-zinc-50 dark:bg-zinc-950 p-4 rounded-2xl border border-zinc-200/60 dark:border-zinc-800">
            
            <!-- Class Name Tag Bar -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-blue-500/10 border border-blue-500/20 text-xs">
              <span class="font-mono font-bold text-blue-600 dark:text-blue-400">.section_hero</span>
              <span class="text-[10px] font-semibold text-zinc-500">Client-First Standard</span>
            </div>

            <!-- Webflow Canvas Component Blocks -->
            <div class="p-3.5 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-2">
              <div class="flex items-center justify-between text-xs font-bold text-zinc-900 dark:text-zinc-100">
                <span>padding-global</span>
                <span class="text-[10px] text-emerald-600 font-mono">Max-W: 1280px</span>
              </div>
              <div class="p-2 rounded bg-zinc-100 dark:bg-zinc-800 text-[11px] font-mono text-zinc-600 dark:text-zinc-400 flex items-center justify-between">
                <span>container-large</span>
                <span class="text-brand-500 font-bold">Flex Layout ✓</span>
              </div>
            </div>

            <!-- Page Speed Metric Pill -->
            <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-between text-xs font-bold text-emerald-700 dark:text-emerald-400">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Google Core Web Vitals
              </span>
              <span class="font-mono text-sm font-extrabold">100 / 100</span>
            </div>

          </div>

          <!-- Floating Micro Badge 1: Relume & Client-First -->
          <div class="absolute -top-3 -right-3 px-3 py-1.5 rounded-full bg-blue-600 text-white text-xs font-bold shadow-lg flex items-center gap-1.5">
            <span>⚡</span> Client-First v2
          </div>

          <!-- Floating Micro Badge 2: Webflow Expert Badge -->
          <div class="absolute -bottom-4 -left-4 p-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-blue-600 text-white font-extrabold flex items-center justify-center text-xs">
              W
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-zinc-100">Webflow Specialist</p>
              <p class="text-[10px] text-zinc-500 dark:text-zinc-400">Figma to Live Site</p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

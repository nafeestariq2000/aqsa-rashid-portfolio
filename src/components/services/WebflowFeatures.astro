---
const features = [
  {
    icon: "🏛️",
    title: "Client-First Class Naming Architecture",
    badge: "Finsweet Standard",
    desc: "Built strictly following Client-First class conventions. Clean, scalable class structures (`.section_hero`, `.padding-global`, `.container-large`) making site maintenance effortless.",
    items: ["Finsweet Client-First v2 Rules", "Global Style Guide & Tokens", "Modular & Reusable Classes"]
  },
  {
    icon: "🚀",
    title: "100/100 Core Web Vitals & Page Speed",
    badge: "Lightning Fast",
    desc: "Optimized for maximum Google PageSpeed Insights performance. Compressed WebP images, clean DOM tree depth, and zero unnecessary script execution.",
    items: ["Automated Responsive Srcset", "Sub-2.0s Largest Contentful Paint", "Zero Cumulative Layout Shift"]
  },
  {
    icon: "🗂️",
    title: "Custom Webflow CMS & Dynamic Collections",
    badge: "Client CMS",
    desc: "Tailored Webflow CMS collections for case studies, blog posts, team bios, and services — allowing you to publish new content without touch coding.",
    items: ["Dynamic Multi-Reference Fields", "Custom Filtering & Sorting", "Editor Access for Content Managers"]
  },
  {
    icon: "📱",
    title: "Fluid Multi-Breakpoint Responsiveness",
    badge: "All Devices",
    desc: "Tested across all modern viewport sizes — from ultra-wide 4K displays down to standard smartphones — guaranteeing smooth scaling.",
    items: ["Desktop (1440px+)", "Tablet & iPad (768px)", "Mobile Portrait (375px)"]
  },
  {
    icon: "✨",
    title: "Custom IX2 Interactions & Lottie Animations",
    badge: "Smooth Micro-UI",
    desc: "Engaging user experience with native Webflow IX2 scroll animations, hover states, accordion triggers, and vector Lottie animations.",
    items: ["Parallax & Scroll Progress", "Lottie Vector Graphics Integration", "60 FPS Hardware-Accelerated UI"]
  },
  {
    icon: "🎯",
    title: "Technical SEO & Webflow Domain Launch",
    badge: "Google Ready",
    desc: "Full pre-launch checklist covering Open Graph social share cards, automated XML sitemaps, 301 redirect mapping, and custom domain connection.",
    items: ["Meta Titles & Descriptions", "Custom 404 Page Design", "Google Search Console Submission"]
  }
];
---

<section id="features" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        TECHNICAL SPECIFICATIONS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Production-Ready Webflow Builds <span class="text-gradient">Engineered for Performance</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Every Figma layout is converted into clean HTML5/CSS3 within Webflow, enforcing Client-First architecture and Google page speed standards.
      </p>
    </div>

    <!-- 6-Card Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((item) => (
        <div class="group relative flex flex-col justify-between p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 hover:border-blue-500/40 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          
          <div>
            <!-- Card Header: Icon & Badge -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100">
                {item.icon}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
                {item.badge}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
              {item.desc}
            </p>
          </div>

          <!-- Feature Bullet Checklist -->
          <div class="pt-6 border-t border-zinc-100 dark:border-zinc-800/80 space-y-2">
            {item.items.map((bullet) => (
              <div class="flex items-center gap-2.5 text-xs font-semibold text-zinc-700 dark:text-zinc-300">
                <span class="text-blue-500 font-bold">✓</span>
                <span>{bullet}</span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

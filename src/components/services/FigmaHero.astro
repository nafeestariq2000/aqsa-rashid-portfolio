---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Soft Ambient Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/10 rounded-full blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-amber-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-zinc-400 dark:text-zinc-500">Services</span>
      <span>/</span>
      <span class="text-brand-600 dark:text-brand-400 font-bold">Figma UI/UX Design</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Live Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
          Figma UI/UX & Landing Page Specialist
        </div>

        <!-- Main H1 Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
          Custom Figma Web UI/UX & <span class="text-gradient">High-Converting</span> Landing Pages.
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed mb-8 max-w-2xl">
          Turn your complex SaaS product vision or business goals into user-centric, intuitive digital layouts. Designed in Figma using Google UX research methodologies and scalable component design systems.
        </p>

        <!-- Key Feature Highlights Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full mb-10 text-xs font-bold text-zinc-700 dark:text-zinc-300">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-brand-500 text-base">🎨</span>
            <span>Figma Auto-Layout 5.0</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-brand-500 text-base">🎓</span>
            <span>Google UX Certified</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm col-span-2 sm:col-span-1">
            <span class="text-brand-500 text-base">⚡</span>
            <span>Interactive Prototypes</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
          >
            Start UI/UX Project
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
          </a>

          <a
            href="#deliverables"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-zinc-700 dark:text-zinc-200 bg-white dark:bg-zinc-900/80 border border-zinc-300 dark:border-zinc-800 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 transition-all duration-300 shadow-sm"
          >
            View Deliverables ↓
          </a>
        </div>

      </div>

      <!-- Right Column: Figma Interactive Canvas Visual Mockup -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-8 lg:mt-0">
        
        <!-- Interactive Figma Canvas Interface Simulation -->
        <div class="relative w-full max-w-md p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl">
          
          <!-- Figma App Header Bar -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-amber-400"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
              <span class="ml-2 text-xs font-bold text-zinc-500 dark:text-zinc-400 font-mono">SaaS_LandingPage_v2.fig</span>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 font-mono">100% Zoom</span>
          </div>

          <!-- Figma Canvas Layers & Component Artboard -->
          <div class="space-y-3 bg-zinc-50 dark:bg-zinc-950 p-4 rounded-2xl border border-zinc-200/60 dark:border-zinc-800">
            
            <!-- Artboard Frame Header -->
            <div class="flex items-center justify-between text-[11px] font-bold text-zinc-500 dark:text-zinc-400">
              <span class="flex items-center gap-1.5">
                <span class="text-brand-500">❖</span> Desktop - 1440px
              </span>
              <span class="text-emerald-600 dark:text-emerald-400 font-mono">Auto Layout ✓</span>
            </div>

            <!-- Canvas Card Preview 1 -->
            <div class="p-3.5 rounded-xl bg-white dark:bg-zinc-900 border border-brand-500/40 shadow-sm relative group">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100">Hero Section Component</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-brand-500 text-white font-mono font-bold">Variant 1</span>
              </div>
              <div class="h-2 w-3/4 bg-zinc-200 dark:bg-zinc-800 rounded mb-1.5"></div>
              <div class="h-2 w-1/2 bg-zinc-100 dark:bg-zinc-800 rounded"></div>
            </div>

            <!-- Canvas Card Preview 2 -->
            <div class="p-3.5 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-bold text-zinc-800 dark:text-zinc-200">Feature Grid Component</span>
                <span class="text-[10px] text-zinc-400 font-mono">3 Columns</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div class="h-8 bg-zinc-100 dark:bg-zinc-800 rounded-lg"></div>
                <div class="h-8 bg-zinc-100 dark:bg-zinc-800 rounded-lg"></div>
                <div class="h-8 bg-zinc-100 dark:bg-zinc-800 rounded-lg"></div>
              </div>
            </div>

            <!-- Design Tokens / Color Palette Strip -->
            <div class="pt-2 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Color Styles:</span>
              <div class="flex items-center gap-1.5">
                <div class="w-4 h-4 rounded-full bg-brand-500 ring-2 ring-white dark:ring-zinc-900" title="Brand Primary"></div>
                <div class="w-4 h-4 rounded-full bg-zinc-900 dark:bg-zinc-100 ring-2 ring-white dark:ring-zinc-900" title="Dark Neutral"></div>
                <div class="w-4 h-4 rounded-full bg-amber-400 ring-2 ring-white dark:ring-zinc-900" title="Accent Gold"></div>
                <div class="w-4 h-4 rounded-full bg-emerald-500 ring-2 ring-white dark:ring-zinc-900" title="Success Green"></div>
              </div>
            </div>

          </div>

          <!-- Floating Micro-Badge 1: Figma Cursor Pin -->
          <div class="absolute -top-3 -right-3 px-3 py-1.5 rounded-full bg-brand-500 text-white text-xs font-bold shadow-lg flex items-center gap-1.5 animate-bounce">
            <span>↖</span> Aqsa (Designing)
          </div>

          <!-- Floating Micro-Badge 2: Google UX Certificate Badge -->
          <div class="absolute -bottom-4 -left-4 p-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-400 to-brand-600 text-white font-extrabold flex items-center justify-center text-xs">
              UX
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-zinc-100">Google UX Certified</p>
              <p class="text-[10px] text-zinc-500 dark:text-zinc-400">Research & Accessibility</p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

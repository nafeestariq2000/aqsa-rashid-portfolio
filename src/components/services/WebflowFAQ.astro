---
const faqs = [
  {
    q: "Why should I convert my Figma design to Webflow manually instead of using automated plugins?",
    a: "Automated plugins create messy inline styles, broken responsive breakpoints, and slow load times. Manual conversion guarantees clean Client-First class naming rules, 100/100 Core Web Vitals speed, and effortless client editing."
  },
  {
    q: "Will I be able to edit text, images, and content on my Webflow site easily?",
    a: "Yes! I configure custom Webflow CMS collections and editor access. You'll be able to update blog posts, team bios, services, and images directly through Webflow's intuitive visual editor without touching code."
  },
  {
    q: "Do you handle custom domain connection, SSL certificates, and SEO redirects?",
    a: "Absolutely! I handle full technical domain setup (GoDaddy, Namecheap, Cloudflare, etc.), SSL security, 301 redirect mapping for old URLs, and XML sitemap submission to Google Search Console."
  },
  {
    q: "What support is included after the site is transferred to my Webflow account?",
    a: "Every Webflow project includes a 14-day post-launch support window to handle minor content tweaks, plus a personalized Loom video tutorial showing you how to manage your Webflow dashboard."
  }
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
});
---

<!-- Embed FAQ Schema -->
<script type="application/ld+json" set:html={faqSchema}></script>

<section id="faq" class="py-20 md:py-28 relative bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        WEBFLOW FREQUENTLY ASKED QUESTIONS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Webflow Development <span class="text-gradient">Questions Answered</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Everything you need to know about Figma to Webflow migration, CMS editing, and post-launch support.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4" id="webflow-faq-accordion">
      {faqs.map((item) => (
        <div class="faq-item rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 overflow-hidden shadow-sm transition-all duration-300">
          
          <button
            class="faq-trigger w-full p-6 flex items-center justify-between text-left focus:outline-none group"
            aria-expanded="false"
          >
            <span class="font-display text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors pr-4">
              {item.q}
            </span>
            <div class="w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-500 group-hover:text-blue-500 transition-all transform duration-300 faq-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
            </div>
          </button>

          <div class="faq-content hidden px-6 pb-6 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed border-t border-zinc-100 dark:border-zinc-800/60 pt-4">
            {item.a}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<!-- Accordion Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('#webflow-faq-accordion .faq-item');

    items.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      trigger.addEventListener('click', () => {
        const isOpen = content.classList.contains('hidden');

        // Close all other items
        items.forEach(otherItem => {
          otherItem.querySelector('.faq-content').classList.add('hidden');
          otherItem.querySelector('.faq-icon').classList.remove('rotate-180', 'text-blue-500');
          otherItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
        });

        // Toggle clicked item
        if (isOpen) {
          content.classList.remove('hidden');
          icon.classList.add('rotate-180', 'text-blue-500');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

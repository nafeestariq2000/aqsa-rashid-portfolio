---
const deliverables = [
  {
    icon: "📱",
    title: "Responsive Desktop & Mobile Layouts",
    badge: "Multi-Breakpoint",
    desc: "Pixel-perfect Figma artboards engineered for Desktop (1440px), Tablet (768px), and Mobile (375px) breakpoints using fluid grid systems.",
    items: ["Auto-Layout 5.0 Flex Containers", "Fluid Typography & Spacing Scale", "Touch-Friendly Target Sizes"]
  },
  {
    icon: "⚡",
    title: "Interactive Clickable Prototypes",
    badge: "Live Testing",
    desc: "Realistic interactive Figma prototypes allowing you and your team to test user flows, navigation menus, and page transitions before development.",
    items: ["Animated Micro-Interactions", "Modal & Drawer Overlays", "Stakeholder Preview Links"]
  },
  {
    icon: "❖",
    title: "Figma Design Systems & UI Kits",
    badge: "Scalable Assets",
    desc: "Complete, reusable component libraries built with variant properties, design tokens, button states, and global color swatches.",
    items: ["Atomic Component Architecture", "Master Typography Hierarchy", "Dark & Light Mode UI Tokens"]
  },
  {
    icon: "🔍",
    title: "Google UX Research & Wireframing",
    badge: "User-Centric",
    desc: "Data-driven wireframes and information architecture grounded in Google UX principles, user empathy mapping, and low-fidelity prototypes.",
    items: ["User Journey & Flow Mapping", "Low-Fidelity Layout Sketches", "WCAG 2.1 AA Contrast Audits"]
  },
  {
    icon: "🎯",
    title: "Conversion-Focused Landing Pages",
    badge: "High ROI",
    desc: "High-converting web layouts structured to capture visitor attention, communicate value propositions clearly, and drive action.",
    items: ["Above-the-Fold Hero Funnels", "Social Proof & Review Strips", "Strategic CTA Placements"]
  },
  {
    icon: "📦",
    title: "Clean Developer Handoff Package",
    badge: "Webflow Ready",
    desc: "Comprehensive developer-ready Figma files with organized layer naming, export-optimized SVGs/WebP images, and Webflow class mapping.",
    items: ["Organized Layer Naming Rules", "Export-Ready Asset Bundles", "Design-to-Code Handoff Guide"]
  }
];
---

<section id="deliverables" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        WHAT'S INCLUDED
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        End-to-End Figma Deliverables <span class="text-gradient">Engineered for Results</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Every project receives production-ready Figma files structured with clean auto-layout 5.0, reusable component variants, and seamless developer handoff specs.
      </p>
    </div>

    <!-- 6-Card Deliverables Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {deliverables.map((item) => (
        <div class="group relative flex flex-col justify-between p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 hover:border-brand-500/40 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          
          <div>
            <!-- Card Header: Icon & Badge -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100">
                {item.icon}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                {item.badge}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
              {item.desc}
            </p>
          </div>

          <!-- Feature Bullet Checklist -->
          <div class="pt-6 border-t border-zinc-100 dark:border-zinc-800/80 space-y-2">
            {item.items.map((bullet) => (
              <div class="flex items-center gap-2.5 text-xs font-semibold text-zinc-700 dark:text-zinc-300">
                <span class="text-brand-500 font-bold">✓</span>
                <span>{bullet}</span>
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

---
const packages = [
  {
    name: "Landing Page Build",
    badge: "Quick Turnaround",
    price: "$450",
    period: "single webflow landing page",
    desc: "Perfect for converting a custom Figma landing page design into a pixel-perfect, responsive Webflow site with lightning-fast load times.",
    timeline: "3 – 5 Business Days",
    features: [
      "Pixel-Perfect Figma to Webflow Build",
      "Client-First Class Architecture",
      "Desktop, Tablet & Mobile Breakpoints",
      "Basic On-Page SEO & Meta Tags",
      "Form Integration & Domain Setup",
      "1 Round of Included Revisions"
    ],
    ctaText: "Book Webflow Landing Page",
    popular: false
  },
  {
    name: "Multi-Page Site + CMS",
    badge: "Most Popular Build",
    price: "$950",
    period: "up to 5 pages + CMS",
    desc: "Comprehensive Webflow development for SaaS platforms, company websites, or portfolios needing dynamic CMS database collections.",
    timeline: "7 – 12 Business Days",
    features: [
      "Up to 5 Custom Webflow Pages",
      "Dynamic Webflow CMS Collections Setup",
      "Custom IX2 Scroll & Hover Animations",
      "100/100 Google Core Web Vitals Audit",
      "301 Redirect Mapping & Technical SEO",
      "Video Handoff Tutorial & 2 Revisions"
    ],
    ctaText: "Choose Multi-Page CMS Build",
    popular: true
  },
  {
    name: "Complex Build & Migration",
    badge: "Enterprise & E-Com",
    price: "$1,500+",
    period: "custom scope",
    desc: "Tailored Webflow builds for large platforms, WordPress/Wix to Webflow migrations, or e-commerce store setups with custom API integrations.",
    timeline: "Custom Priority Timeline",
    features: [
      "Full Site Platform Migration to Webflow",
      "Webflow E-Commerce & Checkout Flow",
      "Advanced Custom JS & GSAP Animations",
      "Finsweet Attributes & Filter Systems",
      "Dedicated Slack / Direct Line Communication"
    ],
    ctaText: "Request Custom Scope",
    popular: false
  }
];
---

<section id="pricing" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-blue-600 dark:text-blue-400 mb-3">
        WEBFLOW PRICING PACKAGES
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Transparent <span class="text-gradient">Webflow Development Pricing</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Fixed-rate pricing with zero hidden development costs, clean code handoff, and video walk-through guides.
      </p>
    </div>

    <!-- 3 Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((item) => (
        <div class={`relative flex flex-col justify-between p-8 rounded-3xl transition-all duration-300 ${
          item.popular
            ? 'bg-white dark:bg-zinc-900 border-2 border-blue-500 shadow-2xl shadow-blue-500/10 scale-100 lg:-translate-y-2'
            : 'bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-lg hover:shadow-xl'
        }`}>
          
          <!-- Popular Badge Tag -->
          {item.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-blue-600 to-brand-500 text-white text-xs font-extrabold uppercase tracking-wider shadow-md">
              ★ Recommended Choice
            </div>
          )}

          <div>
            <!-- Card Header: Title & Badge -->
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">
                {item.name}
              </h3>
              <span class="px-2.5 py-0.5 rounded-md text-xs font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {item.badge}
              </span>
            </div>

            <!-- Price Display -->
            <div class="flex items-baseline gap-2 mb-4">
              <span class="font-display text-4xl sm:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight">
                {item.price}
              </span>
              <span class="text-sm text-zinc-500 font-semibold">/{item.period}</span>
            </div>

            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
              {item.desc}
            </p>

            <!-- Timeline Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/60 dark:border-zinc-800 text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-6">
              <span class="text-blue-500">⏱</span>
              <span>Estimated Delivery: <strong>{item.timeline}</strong></span>
            </div>

            <!-- Features List -->
            <div class="space-y-3 mb-8">
              <p class="text-xs font-bold uppercase tracking-wider text-zinc-400">Package Includes:</p>
              {item.features.map((feat) => (
                <div class="flex items-start gap-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">
                  <span class="text-blue-600 dark:text-blue-400 font-bold mt-0.5">✓</span>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA Button -->
          <a
            href="#contact"
            class={`w-full py-3.5 px-6 rounded-xl text-center text-sm font-bold transition-all duration-300 ${
              item.popular
                ? 'text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 group'
                : 'text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-brand-500 hover:text-white dark:hover:bg-brand-500 group'
            }`}
          >
            <span>{item.ctaText}</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
            </svg>
          </a>

        </div>
      ))}
    </div>

    <!-- Webflow Guarantee Banner -->
    <div class="mt-12 p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
        <span class="text-xl">⚡</span>
        <span>Already have Figma designs ready for development? <strong>Get an accurate Webflow build estimate in under 24 hours.</strong></span>
      </div>
      <a
        href="#contact"
        class="px-5 py-2.5 rounded-xl text-xs font-bold text-blue-600 dark:text-blue-400 bg-blue-500/10 border border-blue-500/20 hover:bg-blue-600 hover:text-white transition-all whitespace-nowrap"
      >
        Send Your Figma File
      </a>
    </div>

  </div>
</section>

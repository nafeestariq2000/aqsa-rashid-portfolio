---
const packages = [
  {
    name: "Landing Page UI",
    badge: "Fast Turnaround",
    price: "$350",
    period: "single landing page",
    desc: "Ideal for SaaS product launches, marketing campaigns, or lead generation landing pages needing high-converting visual layouts.",
    timeline: "3 – 5 Business Days",
    features: [
      "Custom Figma Desktop Layout (1440px)",
      "Mobile Responsive View (375px)",
      "Above-the-Fold Value Prop Architecture",
      "Export-Ready Image & SVG Assets",
      "2 Rounds of Included Revisions"
    ],
    ctaText: "Book Landing Page UI",
    popular: false
  },
  {
    name: "Full Web UI / SaaS App",
    badge: "Most Popular Tiers",
    price: "$750",
    period: "up to 5 pages",
    desc: "Complete design package for web applications, SaaS platforms, or multi-page websites needing a cohesive design system.",
    timeline: "7 – 10 Business Days",
    features: [
      "Up to 5 Figma Page Layouts (Home, About, Services, etc.)",
      "Full Figma Component Design System & UI Kit",
      "Interactive Clickable Prototype for Stakeholders",
      "Desktop, Tablet & Mobile Breakpoints",
      "Google UX Research & Accessibility Audit",
      "Priority Support & Developer Handoff Specs"
    ],
    ctaText: "Choose Full Package",
    popular: true
  },
  {
    name: "Monthly Design Retainer",
    badge: "Agency Partner",
    price: "$1,200",
    period: "per month",
    desc: "Dedicated freelance UI/UX designer on demand for growing startups and agencies requiring continuous design output.",
    timeline: "Ongoing Priority Queue",
    features: [
      "Unlimited Figma Design Request Backlog",
      "Figma to Webflow Handoff Support",
      "Daily Slack / WhatsApp Direct Communication",
      "Fast 48-Hour Turnaround on Tasks",
      "Cancel or Pause Subscription Anytime"
    ],
    ctaText: "Inquire About Retainer",
    popular: false
  }
];
---

<section id="pricing" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        TRANSPARENT PRICING
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Simple, Predictable <span class="text-gradient">Figma UI/UX Packages</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        No hidden fees or scope creep. Clear deliverables, included revisions, and guaranteed deadlines.
      </p>
    </div>

    <!-- 3 Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((item) => (
        <div class={`relative flex flex-col justify-between p-8 rounded-3xl transition-all duration-300 ${
          item.popular
            ? 'bg-white dark:bg-zinc-900 border-2 border-brand-500 shadow-2xl shadow-brand-500/10 scale-100 lg:-translate-y-2'
            : 'bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-lg hover:shadow-xl'
        }`}>
          
          <!-- Popular Badge Tag -->
          {item.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-gradient-to-r from-brand-500 to-brand-600 text-white text-xs font-extrabold uppercase tracking-wider shadow-md">
              ★ Most Popular Choice
            </div>
          )}

          <div>
            <!-- Card Header: Title & Badge -->
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100">
                {item.name}
              </h3>
              <span class="px-2.5 py-0.5 rounded-md text-[10px] font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {item.badge}
              </span>
            </div>

            <!-- Price Display -->
            <div class="flex items-baseline gap-2 mb-4">
              <span class="font-display text-4xl sm:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight">
                {item.price}
              </span>
              <span class="text-xs text-zinc-500 font-semibold">/{item.period}</span>
            </div>

            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
              {item.desc}
            </p>

            <!-- Timeline Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/60 dark:border-zinc-800 text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-6">
              <span class="text-brand-500">⏱</span>
              <span>Estimated Delivery: <strong>{item.timeline}</strong></span>
            </div>

            <!-- Features List -->
            <div class="space-y-3 mb-8">
              <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-400">Package Includes:</p>
              {item.features.map((feat) => (
                <div class="flex items-start gap-2.5 text-xs font-medium text-zinc-700 dark:text-zinc-300">
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold mt-0.5">✓</span>
                  <span>{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- CTA Button -->
          <a
            href="#contact"
            class={`w-full py-3.5 px-6 rounded-xl text-center text-sm font-bold transition-all duration-300 ${
              item.popular
                ? 'text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40'
                : 'text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800 hover:bg-brand-500 hover:text-white dark:hover:bg-brand-500'
            }`}
          >
            {item.ctaText} ↗
          </a>

        </div>
      ))}
    </div>

    <!-- Assurance Banner -->
    <div class="mt-12 p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
        <span class="text-xl">🛡️</span>
        <span>Need a custom scope or enterprise agreement? <strong>Let's tailor a specific design proposal for your budget.</strong></span>
      </div>
      <a
        href="#contact"
        class="px-5 py-2.5 rounded-xl text-xs font-bold text-brand-600 dark:text-brand-400 bg-brand-500/10 border border-brand-500/20 hover:bg-brand-500 hover:text-white transition-all whitespace-nowrap"
      >
        Request Custom Quote
      </a>
    </div>

  </div>
</section>

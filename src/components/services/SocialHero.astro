---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Ambient Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[130px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-pink-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-zinc-400 dark:text-zinc-500">Services</span>
      <span>/</span>
      <span class="text-brand-600 dark:text-brand-400 font-bold">Social Media & Brand Design</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
          High-Engagement Visual Branding Specialist
        </div>

        <!-- Main H1 Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
          High-Impact Social Media & <span class="text-gradient">Visual Brand Assets</span>.
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed mb-8 max-w-2xl">
          Elevate your social media presence with custom Instagram carousels, high-conversion ad banners, LinkedIn branding, and cohesive visual identity guidelines tailored to stop the scroll.
        </p>

        <!-- Key Feature Highlights Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 w-full mb-10 text-xs font-bold text-zinc-700 dark:text-zinc-300">
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-purple-500 text-base">📱</span>
            <span>Instagram Carousels</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
            <span class="text-pink-500 text-base">🎯</span>
            <span>Ad Creatives & Banners</span>
          </div>
          <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white dark:bg-zinc-900/80 border border-zinc-200/80 dark:border-zinc-800 shadow-sm col-span-2 sm:col-span-1">
            <span class="text-brand-500 text-base">🎨</span>
            <span>Brand Style Guides</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
          >
            Start Branding Project
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
          </a>

          <a
            href="#deliverables"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-zinc-700 dark:text-zinc-200 bg-white dark:bg-zinc-900/80 border border-zinc-300 dark:border-zinc-800 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 transition-all duration-300 shadow-sm"
          >
            View Deliverables ↓
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Instagram Carousel Mockup -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-8 lg:mt-0">
        
        <!-- Social Media Artboard Frame -->
        <div class="relative w-full max-w-md p-5 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl">
          
          <!-- Social App Header Bar -->
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-yellow-400 via-pink-500 to-purple-600 p-0.5">
                <div class="w-full h-full bg-white dark:bg-zinc-900 rounded-full flex items-center justify-center text-xs font-bold text-purple-600">
                  AR
                </div>
              </div>
              <div>
                <span class="text-xs font-bold text-zinc-900 dark:text-zinc-100 block leading-none">aqsa_design</span>
                <span class="text-xs text-zinc-400">Instagram Carousel Master</span>
              </div>
            </div>
            <span class="px-2 py-0.5 rounded text-xs font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 font-mono">1080 x 1350px</span>
          </div>

          <!-- Carousel Slide Card Simulation -->
          <div class="space-y-3 bg-gradient-to-br from-zinc-900 via-zinc-950 to-black p-5 rounded-2xl border border-zinc-800 text-white shadow-inner">
            
            <!-- Carousel Top Indicator -->
            <div class="flex items-center justify-between text-xs font-bold text-zinc-400 mb-2">
              <span class="flex items-center gap-1.5 text-brand-400">
                <span>✦</span> SLIDE 1 OF 5
              </span>
              <span class="text-purple-400 font-mono">Swipe Right ➔</span>
            </div>

            <!-- Carousel Headline & Visual Elements -->
            <div class="py-3">
              <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-brand-500 text-white uppercase tracking-wider">
                DESIGN TIP
              </span>
              <h3 class="font-display text-lg font-extrabold text-white mt-3 mb-2 leading-tight">
                How to Structure High-Converting Instagram Carousels.
              </h3>
              <div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden">
                <div class="h-full w-2/3 bg-gradient-to-r from-brand-500 to-purple-500 rounded-full"></div>
              </div>
            </div>

            <!-- Engagement Stats Strip -->
            <div class="pt-2 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400">
              <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-red-400 font-bold">❤️ 2.4k</span>
                <span class="flex items-center gap-1 text-blue-400 font-bold">💬 184</span>
                <span class="flex items-center gap-1 text-amber-400 font-bold">🔖 940</span>
              </div>
              <span class="text-emerald-400 font-bold text-xs">+450% Engagement</span>
            </div>

          </div>

          <!-- Floating Micro Badge 1: Adobe & Figma Tools -->
          <div class="absolute -top-3 -right-3 px-3 py-1.5 rounded-full bg-gradient-to-r from-purple-600 to-pink-600 text-white text-xs font-bold shadow-lg flex items-center gap-1.5">
            <span>✨</span> 1080 x 1350 Carousel
          </div>

          <!-- Floating Micro Badge 2: Brand Identity Badge -->
          <div class="absolute -bottom-4 -left-4 p-3 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-500 to-pink-500 text-white font-extrabold flex items-center justify-center text-xs">
              🎨
            </div>
            <div>
              <p class="text-xs font-bold text-zinc-900 dark:text-zinc-100">Brand Identity</p>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Consistent Visual Assets</p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

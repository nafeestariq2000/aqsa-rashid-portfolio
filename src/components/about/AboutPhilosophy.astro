---
const pillars = [
  {
    step: "01",
    icon: "🧠",
    title: "Empathy-First UX Research",
    desc: "Every design starts with understanding your audience’s pain points, market position, and intent. I create user flows and wireframes that minimize friction and guide visitors toward your primary conversion goal."
  },
  {
    step: "02",
    icon: "🎨",
    title: "High-Contrast Visual Hierarchy",
    desc: "Clean visual organization using fluid typography scales, strict 8pt grid alignment, and intentional color accents. Designs look premium, read effortlessly, and direct focus where it matters most."
  },
  {
    step: "03",
    icon: "❖",
    title: "Scalable Figma Design Systems",
    desc: "Built with Auto-Layout 5.0, reusable component variants, and design tokens. Whether handing off to engineers or expanding your site later, everything is modular and developer-ready."
  },
  {
    step: "04",
    icon: "⚡",
    title: "Performant Webflow Builds",
    desc: "Converting Figma designs into clean, semantic Webflow sites using Client-First CSS architecture. Optimized for 100/100 Core Web Vitals, mobile responsiveness, and easy CMS content editing."
  }
];
---

<section id="philosophy" class="py-24 md:py-32 relative bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        DESIGN PHILOSOPHY & WORKFLOW
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        How I Approach <span class="text-gradient">Digital Design & Webflow</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        A structured, Google UX-certified methodology designed to turn passive website visitors into loyal clients.
      </p>
    </div>

    <!-- 4-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {pillars.map((item) => (
        <div class="p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 shadow-sm hover:shadow-xl hover:border-brand-500/40 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 shadow-sm">
                {item.icon}
              </span>
              <span class="font-display text-2xl font-extrabold text-brand-600 dark:text-brand-400">
                {item.step}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-zinc-200/60 dark:border-zinc-700/60 text-xs font-semibold text-brand-600 dark:text-brand-400">
            Core Standard ✓
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

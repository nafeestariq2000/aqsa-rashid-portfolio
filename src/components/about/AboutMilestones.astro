---
const stats = [
  {
    value: "50+",
    label: "Completed Orders",
    desc: "Delivered across direct client & agency contracts."
  },
  {
    value: "5.0 ★",
    label: "Client Rating",
    desc: "100% positive feedback with repeat clients from USA, Germany, & UK."
  },
  {
    value: "100%",
    label: "On-Time Delivery",
    desc: "Never missed a deadline with structured milestone communication."
  },
  {
    value: "12+",
    label: "Industries Served",
    desc: "SaaS, Fintech, Solar, Healthcare, Hospitality, & E-Commerce."
  }
];

const countries = [
  { flag: "🇺🇸", name: "United States" },
  { flag: "🇩🇪", name: "Germany" },
  { flag: "🇬🇧", name: "United Kingdom" },
  { flag: "🇲🇽", name: "Mexico" },
  { flag: "🇦🇪", name: "UAE" },
  { flag: "🇨🇦", name: "Canada" }
];
---

<section id="milestones" class="py-16 sm:py-20 md:py-24 relative bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-10 sm:gap-12 md:gap-14">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        GLOBAL TRACK RECORD
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Trusted by Founders & <span class="text-gradient">Agencies Worldwide</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Delivering high-converting design systems and Webflow websites to clients across 6+ countries.
      </p>
    </div>

    <!-- 4 Stats Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {stats.map((s) => (
        <div class="p-8 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:border-brand-500/40">
          <div>
            <div class="font-display text-3xl sm:text-4xl font-extrabold text-brand-600 dark:text-brand-400 mb-3">
              {s.value}
            </div>
            <div class="text-base font-bold text-zinc-900 dark:text-zinc-100 mb-2">
              {s.label}
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {s.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- International Footprint Banner -->
    <div class="w-full">
      <div class="p-8 sm:p-10 rounded-3xl bg-zinc-50/80 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div>
          <h4 class="font-display text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-1">
            Global Client Base
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Active design contracts and repeat relationships across North America, Europe, and Asia.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {countries.map((c) => (
            <div class="px-3.5 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-700 text-xs font-bold text-zinc-800 dark:text-zinc-200 shadow-sm flex items-center gap-2">
              <span>{c.flag}</span> {c.name}
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

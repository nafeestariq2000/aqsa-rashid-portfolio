---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Ambient Glow Effects -->
  <div class="absolute top-1/4 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-amber-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-brand-600 dark:text-brand-400 font-bold">About Aqsa Rashid</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Copy & Credentials -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Certification Tag Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-500/30 bg-brand-500/10 text-brand-600 dark:text-brand-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
          <span>🎓</span> Google UX Certified UI/UX Specialist
        </div>

        <!-- Main H1 Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
          Crafting High-Converting Web UI & <span class="text-gradient">Webflow Experiences</span>.
        </h1>

        <!-- Sub-headline -->
        <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed mb-8">
          Hi! I’m <strong>Aqsa Rashid</strong>, a Google Certified Web UI/UX Designer and Webflow Developer based in Karachi, Pakistan. I specialize in turning complex software ideas, SaaS products, and brand goals into clean, intuitive, and performant digital experiences.
        </p>

        <!-- Academic & Professional Certifications Grid -->
        <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          
          <!-- Cert 1: Google UX -->
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-extrabold text-lg shrink-0">
              G
            </div>
            <div>
              <h4 class="font-display text-sm font-bold text-zinc-900 dark:text-zinc-100">
                Google UX Design Specialization
              </h4>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">
                Recognized by Google Coursera
              </p>
            </div>
          </div>

          <!-- Cert 2: CU Boulder -->
          <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-extrabold text-lg shrink-0">
              CU
            </div>
            <div>
              <h4 class="font-display text-sm font-bold text-zinc-900 dark:text-zinc-100">
                Print & Digital Elements of Design
              </h4>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">
                Univ. of Colorado Boulder
              </p>
            </div>
          </div>

        </div>

        <!-- Call to Action Buttons -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#contact"
            class="px-6 py-3.5 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 transition-all"
          >
            Work With Me ↗
          </a>
          <a
            href={`${import.meta.env.BASE_URL}#work`}
            class="px-6 py-3.5 rounded-xl text-xs sm:text-sm font-bold text-zinc-800 dark:text-zinc-200 bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 hover:text-brand-600 dark:hover:text-brand-400 transition-colors shadow-sm"
          >
            Explore Selected Work 📁
          </a>
        </div>

      </div>

      <!-- Right Column: Design System & UI Showcase Frame -->
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl bg-white dark:bg-zinc-900 p-4 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl overflow-hidden group">
          
          <!-- Top Frame Bar -->
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-amber-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400"></div>
              <span class="ml-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">design_system_architecture.fig</span>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              ● Available for Hire
            </span>
          </div>

          <!-- UI Showcase Image -->
          <div class="relative rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950 aspect-[4/3]">
            <img
              src={`${import.meta.env.BASE_URL}images/portfolio/cover-velox-video.png`}
              alt="Aqsa Rashid Design System & UI Workspace Showcase"
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Floating Badge Overlay -->
          <div class="absolute bottom-6 right-6 p-3.5 rounded-2xl bg-white/90 dark:bg-zinc-900/90 border border-zinc-200/80 dark:border-zinc-700 shadow-xl backdrop-blur-md flex items-center gap-3">
            <div class="px-3.5 py-2 rounded-xl bg-brand-500 text-white font-extrabold flex items-center justify-center text-xs sm:text-sm shadow-md whitespace-nowrap">
              5.0 ★
            </div>
            <div>
              <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100">50+ International Orders</p>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">100% Client Satisfaction Rating</p>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

---
const metrics = [
  {
    value: "+450%",
    label: "Organic Reach Surge",
    desc: "30-day Instagram account reach grew from 8.2k to 45.1k organic impressions."
  },
  {
    value: "3.8x",
    label: "Carousel Save Rate",
    desc: "Save-to-impression ratio jumped from 1.2% to 4.6% per multi-slide post."
  },
  {
    value: "142",
    label: "Direct Membership Inquiries",
    desc: "Tracked DMs & link-in-bio clicks resulting in high-value gym memberships."
  },
  {
    value: "< 72h",
    label: "Turnaround Time",
    desc: "Complete visual identity kit & 12 carousel templates delivered ahead of schedule."
  }
];
---

<section id="results" class="py-24 md:py-32 relative bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        CAMPAIGN IMPACT & METRICS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Measurable Growth Through <span class="text-gradient">Strategic Visuals</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        How brand consistency, high contrast, and structured carousels converted passive scrollers into paying members.
      </p>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
      {metrics.map((m) => (
        <div class="p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 flex flex-col justify-between hover:border-brand-500/40 transition-all duration-300">
          <div>
            <div class="font-display text-3xl sm:text-4xl font-extrabold text-brand-600 dark:text-brand-400 mb-2">
              {m.value}
            </div>
            <div class="text-base font-bold text-zinc-900 dark:text-zinc-100 mb-2">
              {m.label}
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {m.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Client Testimonial Card (Breathable & Well Proportioned) -->
    <div class="max-w-4xl mx-auto">
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-br from-zinc-900 via-zinc-900 to-zinc-950 text-white shadow-2xl relative overflow-hidden border border-zinc-800">
        <!-- Background Subtle Glow -->
        <div class="absolute top-0 right-0 -mt-12 -mr-12 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -mb-12 -ml-12 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex items-center gap-1 text-amber-400 text-lg mb-6">
            ★ ★ ★ ★ ★
          </div>

          <blockquote class="text-lg sm:text-xl md:text-2xl font-medium leading-relaxed mb-8 text-zinc-100">
            "Aqsa transformed Apex Fitness from just another local gym page into a recognized brand on Instagram. Her carousel templates and high-contrast color scheme completely elevated our reach. We generated over 140 direct member leads in the first month alone!"
          </blockquote>

          <div class="flex items-center justify-between flex-wrap gap-4 pt-6 border-t border-zinc-800">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-amber-400 to-brand-500 text-zinc-950 font-bold flex items-center justify-center text-lg shadow-md">
                MR
              </div>
              <div>
                <div class="font-display font-bold text-base text-zinc-100">
                  Marcus Vance
                </div>
                <div class="text-xs text-zinc-400">
                  Founder & Head Coach, Apex Fitness Club
                </div>
              </div>
            </div>

            <div class="px-4 py-2 rounded-xl bg-zinc-800/80 border border-zinc-700/60 text-xs font-semibold text-amber-400">
              Verified Client Review ✓
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

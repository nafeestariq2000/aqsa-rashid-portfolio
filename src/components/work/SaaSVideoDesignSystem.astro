---
const componentsList = [
  {
    icon: "🎨",
    title: "Global Color Tokens & Typography Scale",
    desc: "Built a 9-tier color token system (Brand Primary #FD6F00, Dark Neutral #0D0E11, Contrast Accent #8B5CF6) paired with an 8pt fluid typography scale.",
    badge: "Design Tokens"
  },
  {
    icon: "❖",
    title: "Auto-Layout 5.0 Component Variants",
    desc: "Created modular component variants for primary buttons, form inputs, pricing cards, and video timeline controls with interactive state properties.",
    badge: "Auto Layout"
  },
  {
    icon: "📱",
    title: "Multi-Breakpoint Artboard System",
    desc: "Engineered desktop (1440px) and mobile (375px) artboards ensuring seamless handoff for Webflow or React developers without layout ambiguity.",
    badge: "Developer Ready"
  }
];
---

<section id="design-system" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        FIGMA COMPONENT ARCHITECTURE
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        A Scalable <span class="text-gradient">Figma Design System</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Constructed using atomic design methodology to ensure consistency, rapid iteration, and clean developer handoff.
      </p>
    </div>

    <!-- Secondary Portfolio Image Showcase Grid -->
    <div class="mb-16 p-4 sm:p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-zinc-700 dark:text-zinc-300">
          <span class="text-brand-500">❖</span> Figma Artboards & Mobile Responsive Frames
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
          Full Page Layout Showcase
        </span>
      </div>

      <div class="rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
        <img
          src={`${import.meta.env.BASE_URL}images/portfolio/upcheck-full.png`}
          alt="AI SaaS Landing Page Full UI Figma Artboard Layout by Aqsa Rashid"
          class="w-full h-auto object-cover object-top hover:scale-[1.01] transition-transform duration-500"
        />
      </div>
    </div>

    <!-- 3-Card Design System Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {componentsList.map((item) => (
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-lg flex flex-col justify-between hover:border-brand-500/40 transition-all duration-300">
          
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100">
                {item.icon}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">
              {item.title}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-brand-600 dark:text-brand-400">
            Figma Master Component ✓
          </div>

        </div>
      ))}
    </div>

    <!-- Visual Component Palette Preview Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 text-white font-extrabold flex items-center justify-center text-xl shadow-lg">
          ❖
        </div>
        <div>
          <h4 class="font-display text-lg font-bold text-zinc-900 dark:text-zinc-100">
            Figma Component Library Available
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Interested in exploring the full Figma artboards and component variants for your project?
          </p>
        </div>
      </div>

      <a
        href="#contact"
        class="px-6 py-3 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 transition-all whitespace-nowrap inline-flex items-center gap-1.5 group"
      >
        <span>Request Figma File Preview</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7V17"></path>
        </svg>
      </a>

    </div>

  </div>
</section>

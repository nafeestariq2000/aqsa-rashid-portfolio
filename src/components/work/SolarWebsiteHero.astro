---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Ambient Eco Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-emerald-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-amber-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <a href={`${import.meta.env.BASE_URL}#work`} class="hover:text-brand-500 transition-colors">Selected Work</a>
      <span>/</span>
      <span class="text-emerald-600 dark:text-emerald-400 font-bold">Solar & Sustainability Website</span>
    </nav>

    <!-- Header Meta & Title Block -->
    <div class="max-w-4xl mb-12">
      <!-- Tag Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
        <span>☀️</span> Renewable Energy & Sustainability SaaS Web Case Study
      </div>

      <!-- Main H1 Headline -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
        Designing a High-Converting Green Tech Web Experience for <span class="text-gradient">Soller & Aetherfield</span>.
      </h1>

      <!-- Sub-headline -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed">
        A comprehensive UI/UX & Webflow case study demonstrating how clean visual architecture, interactive solar savings calculators, and lightning-fast page load speeds generated +210% more residential and commercial consultation leads.
      </p>
    </div>

    <!-- Key Project Metadata Metrics Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl">
      
      <div class="p-3">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Client Profile:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Soller & Aetherfield</span>
        <span class="text-xs text-zinc-500">Solar & Clean Energy</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Project Scope:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">UI/UX & Webflow Dev</span>
        <span class="text-xs text-zinc-500">Figma to Webflow CMS</span>
      </div>

      <div class="p-3 border-l-0 md:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Deliverables:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Responsive Web System</span>
        <span class="text-xs text-zinc-500">ROI Calculator Component</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800 bg-emerald-500/10 rounded-2xl border border-emerald-500/20">
        <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-1">Impact Metric:</span>
        <span class="text-base font-extrabold text-emerald-600 dark:text-emerald-400 block">+210% Consultations</span>
        <span class="text-xs text-zinc-600 dark:text-zinc-400 font-semibold">100/100 Web Vitals Score</span>
      </div>

    </div>

    <!-- Main Real Portfolio Showcase Frame -->
    <div class="relative w-full rounded-3xl bg-white dark:bg-zinc-900 p-4 sm:p-6 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl overflow-hidden group">
      
      <!-- Top Window Header Bar -->
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
          <span class="ml-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">soller_solar_sustainability.fig — Figma UI & Webflow CMS Showcase</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold border border-emerald-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Live Portfolio Showcase
        </div>
      </div>

      <!-- Real Portfolio Image Showcase -->
      <div class="relative rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950 shadow-lg">
        <img
          src={`${import.meta.env.BASE_URL}images/portfolio/soller-solar-full.png`}
          alt="Soller Solar Energy Company & Sustainability Website Design by Aqsa Rashid"
          class="w-full h-auto object-cover object-top hover:scale-[1.01] transition-transform duration-500"
        />
      </div>

    </div>

  </div>
</section>

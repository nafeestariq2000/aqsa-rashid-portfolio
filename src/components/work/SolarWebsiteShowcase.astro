---
const deliverables = [
  {
    icon: "🌱",
    title: "Aetherfield Sustainability SaaS Platform UI",
    badge: "SaaS Dashboard UI",
    desc: "Complete enterprise dashboard interface monitoring carbon offset metrics, energy production, and ESG compliance reports."
  },
  {
    icon: "📱",
    title: "100% Fluid Mobile Breakpoints (375px to 1440px)",
    badge: "Webflow Mobile UX",
    desc: "Tested across mobile Safari, Android Chrome, and tablets for pixel-perfect typography and touch-friendly CTA buttons."
  },
  {
    icon: "⚡",
    title: "Interactive Savings & ROI Calculator Widget",
    badge: "Custom Webflow Component",
    desc: "Dynamic sliders calculating estimated annual energy bill reductions based on zipcode and property size."
  }
];
---

<section id="showcase" class="py-24 md:py-32 relative bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 mb-3">
        DESIGN DELIVERABLES
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Multi-Screen <span class="text-gradient">Green Tech UI System</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Previewing the Aetherfield Sustainability SaaS dashboard and Soller energy web experience.
      </p>
    </div>

    <!-- 3 Deliverables Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {deliverables.map((item) => (
        <div class="p-8 rounded-3xl bg-zinc-50/80 dark:bg-zinc-800/60 border border-zinc-200/80 dark:border-zinc-700/60 shadow-md flex flex-col justify-between hover:border-emerald-500/40 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 shadow-sm">
                {item.icon}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">
              {item.title}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-zinc-200/60 dark:border-zinc-700/60 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            Figma & Webflow Asset Included ✓
          </div>
        </div>
      ))}
    </div>

    <!-- Secondary Portfolio Image Showcase (Aetherfield SaaS Platform) -->
    <div class="relative w-full rounded-3xl bg-zinc-50 dark:bg-zinc-950 p-4 sm:p-6 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl overflow-hidden mb-12">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-200/80 dark:border-zinc-800">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
          <span class="ml-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">aetherfield_sustainability_saas.fig — Enterprise Platform UI</span>
        </div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">Full Web System</span>
      </div>

      <div class="rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-white dark:bg-zinc-900">
        <img
          src={`${import.meta.env.BASE_URL}images/portfolio/aetherfield-saas-full.png`}
          alt="Aetherfield Sustainability SaaS Web Platform by Aqsa Rashid"
          class="w-full h-auto object-cover object-top hover:scale-[1.01] transition-transform duration-500"
        />
      </div>
    </div>

  </div>
</section>

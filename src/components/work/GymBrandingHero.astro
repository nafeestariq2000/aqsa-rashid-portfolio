---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Subtle Ambient Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-amber-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-brand-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <a href={`${import.meta.env.BASE_URL}#work`} class="hover:text-brand-500 transition-colors">Selected Work</a>
      <span>/</span>
      <span class="text-amber-600 dark:text-amber-400 font-bold">Fitness Gym Social Media Branding</span>
    </nav>

    <!-- Header Meta & Title Block -->
    <div class="max-w-4xl mb-12">
      <!-- Tag Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
        <span>🏋️‍♂️</span> Social Media & Brand Campaign Case Study
      </div>

      <!-- Main H1 Headline -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
        Crafting a High-Contrast Social Campaign to Drive <span class="text-gradient">+450% Engagement Reach</span>.
      </h1>

      <!-- Sub-headline -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed">
        A visual branding case study demonstrating how high-impact Instagram carousel designs, bold typography hierarchy, and multi-channel promo graphics expanded Apex Fitness Club's digital audience reach across 50k+ targeted impressions.
      </p>
    </div>

    <!-- Key Project Metadata Metrics Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12 p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl">
      
      <div class="p-3">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Client Profile:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Apex Fitness Club</span>
        <span class="text-xs text-zinc-500">Premium Gym Center</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Project Role:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Visual Brand Designer</span>
        <span class="text-xs text-zinc-500">Figma & Photoshop</span>
      </div>

      <div class="p-3 border-l-0 md:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Deliverables:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Instagram Carousels</span>
        <span class="text-xs text-zinc-500">Ad Banners & Billboards</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800 bg-amber-500/10 rounded-2xl border border-amber-500/20">
        <span class="text-[11px] font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400 block mb-1">Campaign Reach:</span>
        <span class="text-base font-extrabold text-amber-600 dark:text-amber-400 block">+450% Engagement</span>
        <span class="text-xs text-zinc-600 dark:text-zinc-400 font-semibold">50k+ Total Impressions</span>
      </div>

    </div>

    <!-- Main Real Portfolio Showcase Frame -->
    <div class="relative w-full rounded-3xl bg-white dark:bg-zinc-900 p-4 sm:p-6 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl overflow-hidden group">
      
      <!-- Top Window Header Bar -->
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-zinc-100 dark:border-zinc-800">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
          <span class="ml-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">apex_fitness_carousel_campaign.fig — High-Contrast Social Brand Kit</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold border border-amber-500/20">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          Live Portfolio Showcase
        </div>
      </div>

      <!-- Real Portfolio Image Showcase -->
      <div class="relative rounded-2xl overflow-hidden border border-zinc-200/60 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950 shadow-lg">
        <img
          src={`${import.meta.env.BASE_URL}images/portfolio/fitness-brand-scrollshot.png`}
          alt="Apex Fitness Club Social Media Branding & Instagram Carousel Campaign by Aqsa Rashid"
          class="w-full h-auto object-cover object-top hover:scale-[1.01] transition-transform duration-500"
        />
      </div>

    </div>

  </div>
</section>

---
const metrics = [
  {
    value: "+35%",
    label: "Free Trial Signups",
    desc: "Conversion rate increased from 2.1% to 2.84% within 30 days post-redesign.",
    accent: "from-brand-500 to-amber-500"
  },
  {
    value: "-42%",
    label: "Mobile Bounce Rate",
    desc: "Mobile visitor retention jumped significantly thanks to responsive 375px artboards.",
    accent: "from-purple-500 to-pink-500"
  },
  {
    value: "5.0 ★",
    label: "Client Rating",
    desc: "Delivered on schedule with 100% client satisfaction and repeat contract extension.",
    accent: "from-emerald-500 to-teal-500"
  }
];
---

<section id="results" class="py-24 md:py-32 relative bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400 mb-3">
        MEASURABLE BUSINESS IMPACT
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-5">
        Live Conversion Results <span class="text-gradient">& Client Feedback</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Quantifiable improvements measured across live analytics following the Figma UI redesign deployment.
      </p>
    </div>

    <!-- 3 Metrics Breathable Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {metrics.map((item) => (
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col items-center text-center justify-between">
          <div class="w-full">
            <span class={`font-display text-3xl sm:text-4xl font-extrabold text-gradient bg-gradient-to-r ${item.accent} mb-3 block`}>
              {item.value}
            </span>
            <h3 class="font-display text-lg font-bold text-zinc-900 dark:text-zinc-100 mb-2">
              {item.label}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed max-w-xs mx-auto">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Breathable Proportioned Client Testimonial Card -->
    <div class="max-w-5xl mx-auto p-8 sm:p-12 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 shadow-lg relative">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div class="flex items-center gap-1.5 text-amber-400 text-lg">
          ★★★★★
        </div>
        <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
          Verified Case Study Client
        </span>
      </div>

      <blockquote class="text-lg sm:text-2xl text-zinc-800 dark:text-zinc-200 font-medium leading-relaxed italic mb-10">
        "Aqsa completely transformed our AI SaaS landing page. Her Google UX approach simplified our value proposition so clearly that our free trial signups jumped by 35% within the first month. Communicative, insanely skilled, and delivered a production-ready Figma design system!"
      </blockquote>

      <div class="flex items-center gap-4 pt-8 border-t border-zinc-100 dark:border-zinc-800/80">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-400 to-brand-600 flex items-center justify-center text-white font-extrabold text-lg shadow-md">
          M
        </div>
        <div>
          <h4 class="font-display font-bold text-base text-zinc-900 dark:text-zinc-100">
            Marcus Vance
          </h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
            Co-Founder & Head of Growth, CreateVideo AI — 🇺🇸 San Francisco, CA
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

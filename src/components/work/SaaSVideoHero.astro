---
---

<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden bg-[#f8f9fc] dark:bg-[#0d0e11] transition-colors duration-300">
  <!-- Ambient Glow Background Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-purple-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[250px] h-[250px] bg-brand-500/10 rounded-full blur-[90px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb Trail -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-6" aria-label="Breadcrumb">
      <a href={import.meta.env.BASE_URL} class="hover:text-brand-500 transition-colors">Home</a>
      <span>/</span>
      <a href={`${import.meta.env.BASE_URL}#work`} class="hover:text-brand-500 transition-colors">Selected Work</a>
      <span>/</span>
      <span class="text-purple-600 dark:text-purple-400 font-bold">SaaS Video Editor UI Case Study</span>
    </nav>

    <!-- Header Meta & Title Block -->
    <div class="max-w-4xl mb-12">
      <!-- Tag Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-purple-500/30 bg-purple-500/10 text-purple-600 dark:text-purple-400 text-xs font-bold tracking-wide uppercase mb-6 shadow-sm">
        <span>🎬</span> SaaS Web UI/UX & Conversion Case Study
      </div>

      <!-- Main H1 Headline -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-[1.12] tracking-tight mb-6">
        Redesigning an AI SaaS Landing Page to Drive <span class="text-gradient">+35% Higher Trial Signups</span>.
      </h1>

      <!-- Sub-headline -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 font-normal leading-relaxed">
        A deep-dive case study showing how user empathy research, high-contrast visual hierarchy, and a scalable Figma component system transformed a complex AI video editing tool into a seamless, high-converting digital experience.
      </p>
    </div>

    <!-- Key Project Metadata Metrics Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-14 p-6 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl">
      
      <div class="p-3">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Client Profile:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">AI Tech Startup</span>
        <span class="text-xs text-zinc-500">San Francisco, USA</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Project Role:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Lead UI/UX Designer</span>
        <span class="text-xs text-zinc-500">Google UX Framework</span>
      </div>

      <div class="p-3 border-l-0 md:border-l border-zinc-100 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 block mb-1">Deliverables:</span>
        <span class="text-sm font-extrabold text-zinc-900 dark:text-zinc-100 block">Figma UI & Prototypes</span>
        <span class="text-xs text-zinc-500">Desktop & Mobile Frames</span>
      </div>

      <div class="p-3 border-l-0 sm:border-l border-zinc-100 dark:border-zinc-800 bg-brand-500/5 rounded-2xl">
        <span class="text-[11px] font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400 block mb-1">Core Impact:</span>
        <span class="text-base font-extrabold text-brand-600 dark:text-brand-400 block">+35% Conversion Intent</span>
        <span class="text-xs text-zinc-500">-42% Mobile Bounce Rate</span>
      </div>

    </div>

    <!-- Main Visual Mockup Showcase Frame -->
    <div class="relative w-full rounded-3xl bg-gradient-to-br from-purple-900/30 via-zinc-900 to-black p-6 sm:p-10 border border-zinc-800 shadow-2xl overflow-hidden">
      
      <!-- Top Decorative Controls -->
      <div class="flex items-center justify-between pb-6 mb-6 border-b border-white/10">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
          <span class="ml-2 text-xs font-mono text-zinc-400">app.createvideoinstantly.ai/dashboard</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-white border border-white/10">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Figma High-Fidelity UI
        </div>
      </div>

      <!-- SaaS Interface Hero Preview Screen -->
      <div class="rounded-2xl bg-zinc-950 p-6 sm:p-8 border border-white/10 text-white space-y-6 shadow-2xl">
        
        <!-- Dashboard Top Navigation -->
        <div class="flex items-center justify-between pb-4 border-b border-zinc-800">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center font-bold text-xs">
              AI
            </div>
            <span class="font-display font-bold text-sm tracking-tight">CreateVideo AI</span>
          </div>
          <div class="hidden sm:flex items-center gap-6 text-xs text-zinc-400 font-medium">
            <span class="text-white font-bold">Templates</span>
            <span>AI Voices</span>
            <span>Media Library</span>
            <span>Analytics</span>
          </div>
          <button class="px-4 py-2 rounded-xl bg-brand-500 text-white text-xs font-bold shadow-md hover:bg-brand-600 transition-all">
            + Create New Video
          </button>
        </div>

        <!-- Dashboard Hero Layout Banner -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-2">
          <div class="lg:col-span-7 space-y-3">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
              PROMPT TO VIDEO IN SECONDS
            </span>
            <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-white leading-tight">
              Turn Text Scripts Into Studio-Quality Videos.
            </h2>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Type your script, select an AI avatar voice, and generate full 1080p promotional videos in under 60 seconds with automated captioning.
            </p>
          </div>

          <!-- Video Timeline Card Mockup -->
          <div class="lg:col-span-5 p-4 rounded-xl bg-zinc-900 border border-zinc-800 space-y-3">
            <div class="flex items-center justify-between text-[11px] text-zinc-400 font-mono">
              <span>Rendering Scene #02</span>
              <span class="text-brand-400 font-bold">60 FPS 1080p</span>
            </div>
            <div class="h-24 bg-gradient-to-br from-purple-900/60 to-black rounded-lg flex items-center justify-center border border-white/10 relative overflow-hidden">
              <span class="text-3xl">▶️</span>
              <span class="absolute bottom-2 right-2 text-[9px] px-1.5 py-0.5 rounded bg-black/80 font-mono text-zinc-300">00:45</span>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

---
const painPoints = [
  {
    icon: "📉",
    title: "Overwhelming Technical Jargon",
    desc: "Previous solar site confused homeowners with engineering schematics rather than explaining tangible cost savings and environmental ROI."
  },
  {
    icon: "⏱️",
    title: "Slow 6.4s Page Load Times",
    desc: "Uncompressed imagery and bulky WordPress plugins caused massive bounce rates on mobile ad campaigns."
  },
  {
    icon: "📋",
    title: "Friction-Heavy Consultation Form",
    desc: "A lengthy 12-field form deterred qualified commercial leads from requesting solar site audits."
  }
];

const solutions = [
  {
    icon: "⚡",
    title: "Clean Visual Storytelling",
    desc: "Designed an intuitive 3-pillar layout highlighting Residential, Commercial, and SaaS Analytics for Aetherfield."
  },
  {
    icon: "🧮",
    title: "Interactive Savings Calculator",
    desc: "Built a 2-click interactive slider widget that lets users estimate monthly electric bill savings instantly."
  },
  {
    icon: "🚀",
    title: "Pixel-Perfect Webflow Engine",
    desc: "Clean semantic Webflow build with 100/100 Core Web Vitals performance and instant page load speeds."
  }
];
---

<section id="problem" class="py-24 md:py-32 relative bg-white dark:bg-zinc-900 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 mb-3">
        THE UX DIAGNOSIS
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Transforming Complex Tech Into <span class="text-gradient">Effortless Conversions</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        How strategic Figma UI wireframing and Webflow CMS development eliminated bounce rates and drove high-intent leads.
      </p>
    </div>

    <!-- 2-Column Problem vs Solution Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Column 1: The Problems -->
      <div class="p-8 sm:p-10 rounded-3xl bg-red-500/5 border border-red-500/20 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 text-xs font-bold uppercase tracking-wider mb-6">
            <span>⚠️</span> Pre-Redesign Obstacles
          </div>

          <h3 class="font-display text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6">
            Why Qualified Traffic Failed to Convert
          </h3>

          <div class="space-y-6">
            {painPoints.map((item) => (
              <div class="flex items-start gap-4">
                <span class="text-2xl p-2.5 rounded-2xl bg-white dark:bg-zinc-800 border border-red-500/20 shadow-sm shrink-0">
                  {item.icon}
                </span>
                <div>
                  <h4 class="font-display text-base font-bold text-zinc-900 dark:text-zinc-100 mb-1">
                    {item.title}
                  </h4>
                  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-red-500/15 text-xs font-semibold text-red-600 dark:text-red-400">
          Result: High bounce rates & missed residential solar contracts
        </div>
      </div>

      <!-- Column 2: The Solutions -->
      <div class="p-8 sm:p-10 rounded-3xl bg-emerald-500/5 border border-emerald-500/20 flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider mb-6">
            <span>✨</span> Google UX Design Solution
          </div>

          <h3 class="font-display text-2xl font-bold text-zinc-900 dark:text-zinc-100 mb-6">
            The High-Converting Redesign Blueprint
          </h3>

          <div class="space-y-6">
            {solutions.map((item) => (
              <div class="flex items-start gap-4">
                <span class="text-2xl p-2.5 rounded-2xl bg-white dark:bg-zinc-800 border border-emerald-500/20 shadow-sm shrink-0">
                  {item.icon}
                </span>
                <div>
                  <h4 class="font-display text-base font-bold text-zinc-900 dark:text-zinc-100 mb-1">
                    {item.title}
                  </h4>
                  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-emerald-500/15 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          Result: +210% increase in monthly consultation booking requests
        </div>
      </div>

    </div>

  </div>
</section>

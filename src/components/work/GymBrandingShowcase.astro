---
const showcaseCards = [
  {
    icon: "📱",
    title: "1080 x 1350px Instagram Carousel Decks",
    badge: "Portrait Format",
    desc: "Multi-slide educational decks built with seamless overflow lines and high-contrast gold typography."
  },
  {
    icon: "🎯",
    title: "Promotional Meta & Google Ad Banners",
    badge: "Paid Ad Creatives",
    desc: "Direct-response ad graphics designed to convert cold social traffic into gym membership signups."
  },
  {
    icon: "🏛️",
    title: "Outdoor Billboards & Metal-Frame Mockups",
    badge: "300 DPI Print",
    desc: "High-resolution vector assets for physical outdoor marketing, banners, and event signage."
  }
];
---

<section id="showcase" class="py-20 md:py-28 relative bg-zinc-100/60 dark:bg-zinc-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600 dark:text-amber-400 mb-3">
        BRAND ASSET SHOWCASE
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        Omni-Channel <span class="text-gradient">Visual Brand Deliverables</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400">
        Cohesive visual design system applied across digital feeds, social ads, and outdoor print media.
      </p>
    </div>

    <!-- 3-Card Deliverables Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {showcaseCards.map((item) => (
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-lg flex flex-col justify-between hover:border-amber-500/40 transition-all duration-300">
          
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-3xl p-3 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100">
                {item.icon}
              </span>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">
              {item.title}
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-amber-600 dark:text-amber-400">
            Brand Kit Asset Included ✓
          </div>

        </div>
      ))}
    </div>

    <!-- Visual Banner Request Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
      
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-brand-600 text-white font-extrabold flex items-center justify-center text-xl shadow-lg">
          🏋️‍♂️
        </div>
        <div>
          <h4 class="font-display text-lg font-bold text-zinc-900 dark:text-zinc-100">
            Need High-Impact Social Graphics for Your Brand?
          </h4>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Get custom Instagram carousels, ad banners, and visual style guides designed in 48 to 72 hours.
          </p>
        </div>
      </div>

      <a
        href="#contact"
        class="px-6 py-3 rounded-xl text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-lg shadow-brand-500/25 transition-all whitespace-nowrap"
      >
        Start Social Branding Project ↗
      </a>

    </div>

  </div>
</section>

---
const metrics = [
  {
    value: "+210%",
    label: "Consultation Leads",
    desc: "Monthly qualified residential & commercial solar booking requests skyrocketed within 30 days."
  },
  {
    value: "3.2x",
    label: "ROI Calculator Usage",
    desc: "Interactive savings slider became the top converting interactive element on the website."
  },
  {
    value: "1.4s",
    label: "Average Page Load",
    desc: "Reduced load times from 6.4s down to 1.4s on mobile LTE networks via clean Webflow code."
  },
  {
    value: "100/100",
    label: "Google Web Vitals",
    desc: "Achieved maximum performance, accessibility, and SEO health scores on Google Lighthouse."
  }
];
---

<section id="results" class="py-28 md:py-36 lg:py-48 relative bg-zinc-100/70 dark:bg-zinc-950/80 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col gap-20 md:gap-28 lg:gap-36">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 mb-4">
        MEASURABLE CAMPAIGN IMPACT
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-5">
        Live Conversion Results <span class="text-gradient">& Client Feedback</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Quantifiable improvements measured post-deployment across analytics and lead capture pipelines.
      </p>
    </div>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {metrics.map((m) => (
        <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between hover:border-emerald-500/40">
          <div>
            <div class="font-display text-3xl sm:text-4xl font-extrabold text-emerald-600 dark:text-emerald-400 mb-3">
              {m.value}
            </div>
            <div class="text-base font-bold text-zinc-900 dark:text-zinc-100 mb-2">
              {m.label}
            </div>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              {m.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Client Testimonial Card (Luxuriously Breathable with Flex Gap Separation) -->
    <div class="max-w-5xl mx-auto w-full">
      <div class="p-10 sm:p-14 lg:p-16 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-2xl relative overflow-hidden">
        <!-- Background Subtle Glow -->
        <div class="absolute top-0 right-0 -mt-12 -mr-12 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -mb-12 -ml-12 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
            <div class="flex items-center gap-1.5 text-amber-400 text-xl">
              ★ ★ ★ ★ ★
            </div>
            <div class="px-4 py-1.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs font-bold text-emerald-600 dark:text-emerald-400">
              Verified Case Study Client ✓
            </div>
          </div>

          <blockquote class="text-lg sm:text-2xl md:text-3xl font-medium leading-relaxed mb-10 text-zinc-800 dark:text-zinc-200 italic">
            "Aqsa's redesign of Soller transformed our online lead generation completely. Her Google UX methodology clarified complex solar pricing into an intuitive calculator that tripled our inbound consultation bookings. The Webflow site is fast, modern, and easily managed by our team!"
          </blockquote>

          <div class="flex items-center gap-4 pt-8 border-t border-zinc-100 dark:border-zinc-800">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-emerald-400 to-teal-600 text-white font-extrabold flex items-center justify-center text-xl shadow-md">
              ER
            </div>
            <div>
              <div class="font-display font-bold text-lg text-zinc-900 dark:text-zinc-100">
                Elena Rostova
              </div>
              <div class="text-sm text-zinc-500 dark:text-zinc-400">
                VP of Growth & Marketing, Soller Clean Energy
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

---
const phases = [
  {
    step: "01",
    title: "User Flow & Information Architecture",
    badge: "Figma UX Research",
    desc: "Mapped out separate user funnels for homeowners looking for rooftop solar vs commercial real estate managers seeking utility-scale installations."
  },
  {
    step: "02",
    title: "Eco-Systemic Visual UI Kit",
    badge: "Figma Design System",
    desc: "Created a modern clean tech color palette with emerald greens, solar gold accents, crisp typography, and 8px grid alignment."
  },
  {
    step: "03",
    title: "Webflow Development & CMS",
    badge: "Webflow Build",
    desc: "Engineered clean, reusable Webflow CMS collections for solar installation case studies, energy blog articles, and team profiles."
  },
  {
    step: "04",
    title: "Performance & Conversion Optimization",
    badge: "Core Web Vitals",
    desc: "Optimized WebP image assets, lazy loading, clean Client-First CSS architecture, and 100/100 Lighthouse performance."
  }
];
---

<section id="strategy" class="py-24 md:py-32 relative bg-zinc-100/60 dark:bg-zinc-950/60 border-t border-zinc-200/80 dark:border-zinc-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-400 mb-3">
        EXECUTION FRAMEWORK
      </span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
        The 4-Phase <span class="text-gradient">Green Tech Design Process</span>.
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        From initial wireframes to custom Webflow CMS architecture and speed optimization.
      </p>
    </div>

    <!-- 4-Card Strategy Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {phases.map((item) => (
        <div class="p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-lg flex flex-col justify-between hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300">
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="font-display text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">
                {item.step}
              </span>
              <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                {item.badge}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-zinc-900 dark:text-zinc-100 mb-3">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            Phase Complete ✓
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

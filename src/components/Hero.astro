---
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Subtle Ambient Glow Effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-[300px] h-[300px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <!-- Left Column: Copy & Call To Action -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Live Status Pill Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold tracking-wide uppercase mb-6 shadow-sm shadow-emerald-500/10">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          Available for Freelance & Remote Work
        </div>

        <!-- Main H1 Headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900 leading-[1.12] tracking-tight mb-6">
          Designing Clean, Modern & <span class="text-gradient">High-Converting</span> Digital Experiences.
        </h1>

        <!-- Sub-headline / Value Motto -->
        <p class="text-lg sm:text-xl text-zinc-400 dark:text-zinc-400 light:text-zinc-600 font-normal leading-relaxed mb-8 max-w-2xl">
          Google UX Certified Web UI/UX Designer & Figma Specialist. Turning complex ideas into intuitive landing pages, responsive Webflow sites, and high-impact brand visual assets.
        </p>

        <!-- Credentials & Authority Strip -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-10 text-xs sm:text-sm font-medium text-zinc-400 dark:text-zinc-400 light:text-zinc-600 border-l-2 border-brand-500/80 pl-4 py-1">
          <div class="flex items-center gap-2">
            <span class="text-brand-400 text-base">🎓</span>
            <span>Google UX Certified</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-brand-400 text-base">🏛️</span>
            <span>Univ. of Colorado Boulder UX</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 text-base">★</span>
            <span class="text-zinc-200 dark:text-zinc-200 light:text-zinc-800 font-bold">5.0 Rating</span>
            <span>(51+ Orders)</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
          <a
            href="#work"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 shadow-xl shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300"
          >
            View Selected Work
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg>
          </a>

          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl text-base font-bold text-zinc-200 dark:text-zinc-200 light:text-zinc-800 bg-zinc-900/80 dark:bg-zinc-900/80 light:bg-zinc-200/80 border border-zinc-800 dark:border-zinc-800 light:border-zinc-300 hover:border-brand-500/50 hover:text-brand-400 transition-all duration-300"
          >
            Book a Call ✉️
          </a>
        </div>

      </div>

      <!-- Right Column: Hero Visual Portrait & Floating Micro-Cards -->
      <div class="lg:col-span-5 relative flex items-center justify-center mt-6 lg:mt-0">
        
        <!-- Glowing Circular Background Frame -->
        <div class="relative w-[320px] h-[320px] sm:w-[400px] sm:h-[400px]">
          
          <!-- Outer Decorative Rings -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-brand-500 to-amber-400 opacity-20 blur-xl animate-pulse-slow"></div>
          <div class="absolute inset-2 rounded-full border border-brand-500/30"></div>

          <!-- Portrait Image Container -->
          <div class="absolute inset-4 rounded-full overflow-hidden border-4 border-zinc-900 dark:border-zinc-900 light:border-white shadow-2xl shadow-black/80">
            <img
              src="/images/aqsa-portrait.jpg"
              alt="Aqsa Rashid - Google UX Certified UI/UX Designer"
              class="w-full h-full object-cover object-center scale-105 hover:scale-110 transition-transform duration-700"
            />
          </div>

          <!-- Floating Micro-Card 1: Completed Projects -->
          <div class="absolute -top-4 -left-4 sm:-left-8 glass-card p-3.5 rounded-2xl shadow-xl shadow-black/40 flex items-center gap-3 border border-white/10 animate-float">
            <div class="w-10 h-10 rounded-xl bg-brand-500/20 text-brand-400 flex items-center justify-center text-lg font-bold">
              🚀
            </div>
            <div>
              <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-400 light:text-zinc-600">Projects Delivered</p>
              <p class="text-sm font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900">51+ International</p>
            </div>
          </div>

          <!-- Floating Micro-Card 2: Fiverr Rating -->
          <div class="absolute -bottom-4 -right-4 sm:-right-6 glass-card p-3.5 rounded-2xl shadow-xl shadow-black/40 flex items-center gap-3 border border-white/10 animate-float" style="animation-delay: 1.5s;">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-lg font-bold">
              ★
            </div>
            <div>
              <p class="text-xs font-semibold text-zinc-400 dark:text-zinc-400 light:text-zinc-600">Fiverr Top Rated</p>
              <p class="text-sm font-extrabold text-zinc-100 dark:text-zinc-100 light:text-zinc-900">5.0 ★ (42 Reviews)</p>
            </div>
          </div>

          <!-- Floating Micro-Card 3: Google UX Badge -->
          <div class="absolute bottom-12 -left-6 sm:-left-12 glass-card px-3.5 py-2.5 rounded-xl shadow-xl shadow-black/40 flex items-center gap-2.5 border border-white/10">
            <div class="w-2.5 h-2.5 rounded-full bg-brand-500"></div>
            <span class="text-xs font-bold text-zinc-200 dark:text-zinc-200 light:text-zinc-800">Google UX Specialist</span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
